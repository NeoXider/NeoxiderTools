}

.vl-hero-content.htu-media-base {
    align-items: center;
}

.vl-badge.htu-media-base {
    height: 34px;
    padding-right: 18px;
    padding-left: 18px;
    border-width: 1px;
    border-color: rgba(230, 235, 244, 0.7);
    border-radius: 20px;
    background-color: rgba(255, 255, 255, 0.7);
