  m_Name: 
  m_EditorClassIdentifier: Neo.Rpg.Demo::Neo.Samples.ModuleDemoSceneInfo
  _moduleName: "Neo.UI \xB7 AnimationFly"
  _purpose: 'Reward fly effects: coins, gems and icons fly from world, screen or
    UI points into UI counters, with pooling and reward callbacks.'
  _runtimeApi: AnimationFly.I.Play(new AnimationFlyRequest { Sprite or Prefab, Count,
    StartTransform, EndTransform, OnReward }).
  _sceneWorkflow: '[Demo] Services/Animation Fly holds the defaults (Spawn Parent
    = Fly Layer, Bonus Prefab List). Select a button to see its onClick wiring.'
  _verification: Coins land in the wallet, gems in the gem counter; pause time and
    the flights still finish on unscaled time.
  _showRuntimeOverlay: 1
  _corner: 0
  _accentColor: {r: 1, g: 0.76, b: 0.24, a: 1}
  _backgroundColor: {r: 0.11764706, g: 0.11764706, b: 0.15686275, a: 0.8509804}
  _panelWidth: 460
  _startCollapsed: 0
  _hints:
  - Sliders write AnimationFly fields; Count goes into the request
  - 'Pooled prefab: DisableAndPool reuses instances (watch OwnedVisualCount)'
  - Grant rewards in OnReward, not right after Play
  _overlayRoot: {fileID: 162729495}
  _titleLabel: {fileID: 1971618339}
  _descriptionLabel: {fileID: 1804596872}
  _hintsLabel: {fileID: 1791196263}
  _collapseLabel: {fileID: 1679495205}
  _collapsibleParts:
