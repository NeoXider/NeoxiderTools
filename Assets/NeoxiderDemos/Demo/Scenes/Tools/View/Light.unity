--- !u!114 &1965814464
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1965814462}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#FFD15C>\xBB</color>  <b>Runtime API:</b> lightAnimator.Play /
    Pause / Resume / Stop / ResetToOriginal; AnimationSpeed, Min/MaxIntensity, AnimationType;
    ManualUpdate + Tick(dt); UseUnscaledTime; Intensity (reactive).\n<color=#FFD15C>\xBB</color> 
    <b>Scene workflow:</b> Select a 'Light (n)' object to see its LightAnimator;
    its Sphere child carries MeshEmission. 'Light' wires Intensity.OnChanged to the
    card label in the Inspector.\n<color=#FFD15C>\xBB</color>  <b>Verification:</b>
    Enter Play Mode: lights flicker/pulse, Manual clock freezes them until Step,
    and with Unscaled time on they ignore Time.timeScale = 0.\n<color=#FFD15C>\xBB</color> 
    Card -> LightDemoController -> the real LightAnimator API\n<color=#FFD15C>\xBB</color> 
    Manual clock: ManualUpdate = true, then Tick(0.1) per Step\n<color=#FFD15C>\xBB</color> 
    Intensity.OnChanged -> label: a NoCode reactive binding"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
