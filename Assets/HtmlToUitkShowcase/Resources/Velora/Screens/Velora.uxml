<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="Velora.uss" />
    <ui:VisualElement name="vl-velora-root" class="vl-root htu-media-base">
        <ui:VisualElement class="vl-header htu-media-base">
            <ui:VisualElement class="vl-header-inner htu-media-base">
                <ui:Button name="vl-brand-home" text="velora.brand.home" class="vl-brand-button htu-media-base" />
                <ui:VisualElement name="vl-desktop-nav" class="vl-desktop-nav htu-media-base">
                    <ui:Button name="vl-nav-components" text="velora.nav.components" class="vl-nav-link htu-media-base" tooltip="Opens https://velora.colorlib.com/components in your browser" />
                    <ui:Button name="vl-nav-blocks" text="velora.nav.blocks" class="vl-nav-link htu-media-base" tooltip="Opens https://velora.colorlib.com/blocks in your browser" />
                    <ui:Button name="vl-nav-templates" text="velora.nav.templates" class="vl-nav-link htu-media-base" tooltip="Opens https://velora.colorlib.com/templates in your browser" />
                    <ui:Button name="vl-nav-themes" text="velora.nav.themes" class="vl-nav-link htu-media-base" tooltip="Opens https://velora.colorlib.com/themes in your browser" />
                    <ui:Button name="vl-nav-pricing" text="velora.nav.pricing" class="vl-nav-link htu-media-base" />
                    <ui:Button name="vl-nav-changelog" text="velora.nav.changelog" class="vl-nav-link htu-media-base" tooltip="Opens https://velora.colorlib.com/changelog in your browser" />
                </ui:VisualElement>
                <ui:VisualElement class="vl-header-actions htu-media-base">
                    <ui:Button name="vl-search-open" text="velora.search.open" class="vl-search htu-media-base" />
                    <ui:Button name="vl-theme-toggle" text="velora.theme.toggle" class="vl-icon-button htu-media-base" />
                    <ui:Button name="vl-motion-toggle" text="velora.motion.toggle" class="vl-motion-button htu-media-base" />
                    <ui:Button name="vl-original-open" text="velora.original.open" class="vl-source-button htu-media-base" />
                    <ui:Button name="vl-menu-toggle" text="velora.menu.toggle" class="vl-menu-button htu-media-base" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="vl-page-host htu-media-base">
            <ui:ScrollView name="vl-page-home" class="vl-page htu-media-base">
                <ui:VisualElement name="vl-home-hero" class="vl-hero htu-media-base">
                    <ui:VisualElement class="vl-aurora htu-media-base" picking-mode="Ignore">
