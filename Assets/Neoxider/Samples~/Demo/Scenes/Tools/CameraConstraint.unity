  m_Script: {fileID: 11500000, guid: 2f9eb3d1945ff1640a88058f7d4f2b42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Neo.Rpg.Demo::Neo.Samples.ModuleDemoSceneInfo
  _moduleName: "Neo.Tools \xB7 CameraConstraint"
  _purpose: Main Camera is dragged by MouseMover2D; CameraConstraint clamps it every
    LateUpdate so the view never leaves '9-Sliced' BoxCollider2D, for the current
    zoom and aspect.
  _runtimeApi: constraint.SetBoundsSource(CameraConstraint.BoundsType.BoxCollider2D,
    box), SetEdgePadding(f), SetAxisConstraint(x, y, z), UpdateBounds(), GetConstraintBounds(out
    min, out max), IsAtEdge(...).
  _sceneWorkflow: 'Select Main Camera: CameraConstraint (bounds type, source, padding,
    axes) and MouseMover2D (DeltaRaw) are Inspector fields. The padding slider calls
    SetEdgePadding directly.'
  _verification: Drag up and down; Jump up / down throw the camera far away and it
    snaps back to the edge. Zoom out past the bounds width and X is pinned to the
    centre.
  _showRuntimeOverlay: 1
  _corner: 0
  _accentColor: {r: 0.98, g: 0.72, b: 0.3, a: 1}
  _backgroundColor: {r: 0.11764706, g: 0.11764706, b: 0.15686275, a: 0.8509804}
  _panelWidth: 400
  _startCollapsed: 0
