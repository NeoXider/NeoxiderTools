MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 750135730}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2f9eb3d1945ff1640a88058f7d4f2b42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Neo.Rpg.Demo::Neo.Samples.ModuleDemoSceneInfo
  _moduleName: "Neo.Save \xB7 SaveManager + SaveProvider"
  _purpose: 'Two save layers. SaveDemoController is a SaveableBehaviour: fields with
    [SaveField(key)] persist through SaveManager. The wallet is a plain 64-bit key
    (SaveProvider.SetLong, above int.MaxValue). The scene uses a FileSaveProvider,
    so the demo never touches your PlayerPrefs.'
  _runtimeApi: SaveManager.Save(component) / Load(component) / FlushNow(); SaveProvider.SetLong
    / GetLong / Save / Load / OnDataSaved; FileSaveProvider.HasUnsavedChanges / FilePath.
  _sceneWorkflow: '''Save Demo'' holds SaveManager and SaveProviderSettingsComponent
    with Data/Save/SaveDemoProviderSettings (File provider, neo_save_demo.json).
    Buttons call SaveDemoController or SaveManager.FlushNow through persistent UnityEvents.'
  _verification: 'Change values (Unsaved changes: YES), Save, stop and re-enter Play
    Mode: the values return. Save twice: two OnDataSaved events, one file write.'
  _showRuntimeOverlay: 1
  _corner: 0
  _accentColor: {r: 0.26, g: 0.85, b: 0.64, a: 1}
  _backgroundColor: {r: 0.11764706, g: 0.11764706, b: 0.15686275, a: 0.8509804}
  _panelWidth: 460
  _startCollapsed: 0
  _hints:
  - '''Save Demo'' -> SaveProviderSettingsComponent -> SaveDemoProviderSettings (File
    provider)'
  - Btn_FlushNow (NoCode) -> SaveManager.FlushNow; other buttons -> SaveDemoController
  - "Save twice: OnDataSaved \xD72, file written \xD71 (FileSaveProvider write batching)"
  _overlayRoot: {fileID: 964055280}
  _titleLabel: {fileID: 276901724}
  _descriptionLabel: {fileID: 1400658546}
  _hintsLabel: {fileID: 1616166421}
  _collapseLabel: {fileID: 639873044}
  _collapsibleParts:
  - {fileID: 1665285711}
  - {fileID: 407105287}
