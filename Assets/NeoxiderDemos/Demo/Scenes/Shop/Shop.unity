--- !u!114 &301007509
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 301007508}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2f9eb3d1945ff1640a88058f7d4f2b42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Neo.Rpg.Demo::Neo.Samples.ModuleDemoSceneInfo
  _moduleName: "Neo.Shop \xB7 Shop + Money"
  _purpose: 'A storefront made of the module''s own components: Shop (catalog, purchase
    flow, save), Money (wallet) and one ShopItem card per item with ButtonPrice +
    ShopPurchaseButtonView (Buy / Equip / Equipped / Unaffordable). Nothing is built
    at runtime.'
  _runtimeApi: shop.TryBuy(item) -> ShopPurchaseStatus; Buy / Select / IsOwned /
    CanAfford / GetPrice; SetRuntimePrice / ClearRuntimePrice; money.Add / Spend
    / CanSpend; events OnPurchasedId, OnPurchaseFailedId, OnSelectId, OnShopChanged.
  _sceneWorkflow: 'Select ''Shop'': its Shop Items are the cards in ''[Demo] Frame/Content/Storefront
    Cards'' and Auto Subscribe binds each price button to Buy. ''Money'' is the wallet;
    the balance label is a TextMoney. Shop''s string events and On Shop Changed call
    ''Demo Controller''.'
  _verification: 'Play: buy the cards - peperoni (free, equips at once), italian
    (25 coins), cheese (100 coins). With too few coins a card turns Unaffordable
    and its button disables. Purchases and the balance persist between plays until
    Reset.'
  _showRuntimeOverlay: 1
  _corner: 0
  _accentColor: {r: 1, g: 0.78, b: 0.3, a: 1}
  _backgroundColor: {r: 0.11764706, g: 0.11764706, b: 0.15686275, a: 0.8509804}
  _panelWidth: 400
  _startCollapsed: 0
  _hints:
  - Price button -> Shop.Buy (Auto Subscribe) -> Money.Spend
  - +25 / +100 / Empty -> Money directly (NoCode persistent calls)
  - TryBuy row -> ShopDemoController -> shop.TryBuy -> ShopPurchaseStatus
  - ShopItem.OnSelectItem -> Equipped Glow.SetActive(true)
  _overlayRoot: {fileID: 1643195630}
  _titleLabel: {fileID: 1324417279}
  _descriptionLabel: {fileID: 163647668}
  _hintsLabel: {fileID: 1545360342}
  _collapseLabel: {fileID: 121676394}
  _collapsibleParts:
  - {fileID: 964482144}
  - {fileID: 535493334}
