MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1013009885}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2f9eb3d1945ff1640a88058f7d4f2b42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Neo.Rpg.Demo::Neo.Samples.ModuleDemoSceneInfo
  _moduleName: "Neo.NPC \xB7 NpcNavigation"
  _purpose: 'Four NavMesh NPCs, one NpcNavigation each: the blue Chaser follows the
    orbiting red target, the white Guard switches Follow / Patrol / Combined from
    the card, the green Patroller walks its route and the orange Sentry patrols its
    zone until the target comes within 6 m.'
  _runtimeApi: npc.SetMode(NavigationMode) / SetFollowTarget / SetCombinedTarget
    / SetDestination / RefreshPath / SetRunning / Stop / Resume; IsChasing, IsRunning,
    Mode; events onModeChanged, onStartFollowing / onStopFollowing, onPatrolPointReached,
    onMovementStarted / Stopped.
  _sceneWorkflow: Select 'NPC Chaser', 'NPC Guard' or '[Demo] World/NPC Patroller
    | NPC Sentry' to see NpcNavigation + NavMeshAgent. Their events call '[Demo]
    Services/Demo Controller'; the Sentry's onStartFollowing also turns on its red
    'Alert' (GameObject.SetActive, NoCode).
  _verification: 'Play: Chaser and Guard path around the yellow walls; Run raises
    the Chaser''s speed and Stop freezes it; the Guard changes mode from the card;
    the Sentry''s alert lights while it chases. Stagger Path Updates spreads the
    NPCs'' re-paths over the 0.5 s interval.'
  _showRuntimeOverlay: 1
  _corner: 0
  _accentColor: {r: 0.35, g: 0.85, b: 0.55, a: 1}
  _backgroundColor: {r: 0.11764706, g: 0.11764706, b: 0.15686275, a: 0.8509804}
  _panelWidth: 400
  _startCollapsed: 0
  _hints:
  - Walk / Run, Stop / Resume -> NpcNavigation directly (NoCode)
  - Follow / Patrol / Combined -> NpcDemoController.SetGuardMode -> guard.SetMode
  - Sentry onStartFollowing -> Alert.SetActive(true) + log
  - Orbit speed slider -> ConstantRotator.SetDegreesPerSecond
  _overlayRoot: {fileID: 1762102202}
  _titleLabel: {fileID: 1207343236}
  _descriptionLabel: {fileID: 438360953}
  _hintsLabel: {fileID: 567211741}
  _collapseLabel: {fileID: 1728561249}
  _collapsibleParts:
  - {fileID: 824807567}
  - {fileID: 539201853}
