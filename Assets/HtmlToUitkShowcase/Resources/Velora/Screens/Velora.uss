    height: 36px;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: #111114;
    font-size: 21px;
}

.vl-mobile-nav.htu-media-base {
    position: absolute;
    left: 0;
    top: 64px;
    right: 0;
