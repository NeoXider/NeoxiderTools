--- !u!114 &1440155291
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1440155289}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#FF739E>\xBB</color>  <b>Runtime API:</b> FieldGenerator.GenerateField
    / SetWalkable / SetEnabled / SetOccupied, GridShapeMask.Create, GridPathfinder.TryFindPath
    / CollectReachableCells, Match3BoardService.TrySwapAndResolve / TryFindValidSwap
    / InitializeBoard.\n<color=#FF739E>\xBB</color>  <b>Scene workflow:</b> Select
    GridSystem_Match3: FieldGenerator (size, shape mask, movement preset), Match3BoardService
    (min match, tiles, delay) and GridSystemMatch3BoardView. Their events are wired
    in the Inspector.\n<color=#FF739E>\xBB</color>  <b>Verification:</b> Play: swap
    to clear lines; Cut corners / Diamond regenerate the field and the view follows;
    Block / Disable / Occupy change single cells; the path avoids them.\n<color=#FF739E>\xBB</color> 
    Buttons -> GridSystemMatch3DemoUI on 'GridSystemMatch3DemoUI'; each calls one
    GridSystem API.\n<color=#FF739E>\xBB</color>  Match3BoardService.OnMatchesResolved
    -> GridSystemMatch3DemoUI.HandleMatchesResolved (Inspector).\n<color=#FF739E>\xBB</color> 
    Cyan outline = cells from GridPathfinder; [Demo] Board Preview shows the layout
    in Edit Mode only."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
