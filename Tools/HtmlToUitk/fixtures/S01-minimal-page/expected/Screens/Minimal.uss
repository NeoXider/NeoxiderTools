.mn {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.mn__title {
    margin-bottom: 12px;
    font-size: 24px;
}

.mn__action {
    min-width: 160px;
    height: 44px;
    border-radius: 6px;
    background-color: rgba(30, 58, 58, 0.8);
}
