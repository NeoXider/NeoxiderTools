                    <ui:VisualElement class="vl-container vl-hero-content htu-media-base">
                        <ui:Label name="vl-home-badge" text="velora.home.badge" class="vl-badge vl-reveal htu-media-base" focusable="true" tabindex="0" />
                        <ui:VisualElement class="vl-hero-heading htu-media-base">
                            <ui:Label name="vl-home-heading-line" text="velora.home.heading.line" class="vl-hero-title htu-media-base" />
                            <ui:VisualElement class="vl-title-line htu-media-base">
                                <ui:Label name="vl-home-feel" text="velora.home.feel" class="vl-hero-title htu-media-base" />
                                <ui:Label name="vl-hero-word" text="velora.hero.word" class="vl-hero-title vl-animated-word vl-loop htu-media-base" />
                                <ui:Label name="vl-hero-cursor" text="velora.hero.cursor" class="vl-hero-title vl-cursor vl-loop htu-media-base" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label name="vl-home-lead" text="velora.home.lead" class="vl-lead vl-muted vl-hero-lead htu-media-base" />
                        <ui:VisualElement class="vl-hero-actions vl-reveal-late htu-media-base">
                            <ui:VisualElement class="vl-shimmer-wrap htu-media-base">
                                <ui:Button name="vl-home-start" text="velora.home.start" class="vl-primary-button htu-media-base" />
