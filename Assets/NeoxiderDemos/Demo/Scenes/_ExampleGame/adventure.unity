--- !u!114 &589312293
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 589312292}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2f9eb3d1945ff1640a88058f7d4f2b42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Neo.Rpg.Demo::Neo.Samples.ModuleDemoSceneInfo
  _moduleName: "Example game \xB7 Adventure"
  _purpose: 'A first-person sandbox assembled only from library prefabs, components
    and UnityEvents, without game scripts: physics zones, interactables, AI NPCs,
    pickups and an inventory with a hand slot.'
  _runtimeApi: InventoryComponent.AddItemById / DropSelected / Save, ExplosiveForce.Explode(),
    Spawner.StartSpawn / StopSpawn, Selector.Next / Previous, InteractiveObject events.
  _sceneWorkflow: First Person Controller (1) = PlayerController3DPhysics + InventoryComponent,
    InventoryHand, InventoryDropper, Selector; Physics = zones and interactables;
    NPC = AiNavigation / NpcNavigation prefabs on a NavMeshSurface.
  _verification: WASD + mouse to walk, E interacts, walk into the spheres to pick
    them up, 1 / 2 switch the hand slot, G drops the held item. Esc frees the cursor
    (to collapse this card).
  _showRuntimeOverlay: 1
  _corner: 0
  _accentColor: {r: 0.25, g: 0.79, b: 0.94, a: 1}
  _backgroundColor: {r: 0.11764706, g: 0.11764706, b: 0.15686275, a: 0.8509804}
  _panelWidth: 440
  _startCollapsed: 0
  _hints:
  - 'Physics/Cube: PhysicsEvents3D onTriggerEnter / Exit -> SpawnerCars.StartSpawn
    / StopSpawn + particles on / off'
  - Magnetic = MagneticField (attract / repel cycle), Impulse Zone = ImpulseZone
    (pushes bodies away from its center)
  - 'Explosive Interactive Sphere (2): InteractiveObject (E) -> ExplosiveForce.Explode()'
  - 'Interactive Sphere (1): E -> VisualToggle.Toggle -> Terrain renderer on / off'
  - 'Keys: MultiKeyEventTrigger 1 / 2 -> Selector.Previous / Next = the InventoryHand
    slot'
  - 'Pickups: PickableItem + InventoryPickupBridge fill the inventory, Inventory
    (InventoryView) lists it; saved under NeoDemo.Adventure.Inventory'
  _overlayRoot: {fileID: 315306389}
  _titleLabel: {fileID: 737104975}
  _descriptionLabel: {fileID: 167447324}
  _hintsLabel: {fileID: 1602589099}
  _collapseLabel: {fileID: 176548209}
  _collapsibleParts:
  - {fileID: 2046703392}
  - {fileID: 1796435833}
