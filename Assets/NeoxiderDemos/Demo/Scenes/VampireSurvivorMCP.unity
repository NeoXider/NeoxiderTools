  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#FF5C7A>\xBB</color>  <b>Runtime API:</b> Spawner.StartSpawn /
    StopSpawn / OnObjectSpawned, RpgCharacter.DamageType / Restore / OnDeathEvent,
    NpcNavigation.SetFollowTarget.\n<color=#FF5C7A>\xBB</color>  <b>Scene workflow:</b>
    first Person Controller: PlayerController3DPhysics + RpgCharacter + AuraWeapon;
    WaveSpawner_1..3: Spawner; controller: VampireSurvivorDemoController + RpgWorldHealthBars.\n<color=#FF5C7A>\xBB</color> 
    <b>Verification:</b> Enemies spawn and chase; Damage Player until YOU DIED appears;
    Reset Run restores.\n<color=#FF5C7A>\xBB</color>  Esc frees the cursor to click
    the buttons\n<color=#FF5C7A>\xBB</color>  Buttons -> VampireSurvivorDemoController
    (persistent OnClick)\n<color=#FF5C7A>\xBB</color>  [Demo] Health Bars: canvas
