  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#FAB84C>\xBB</color>  <b>Runtime API:</b> GameSettings.SetMouseSensitivity
    / SetGraphicsPreset / SetFramerateCap / SetVSync / ResetGroup / FlushPendingSettingsSave;
    GameSettingsComponent.HasPendingDeferredSave.\n<color=#FAB84C>\xBB</color>  <b>Scene
    workflow:</b> One GameSettingsComponent per scene; UI controls call it through
    persistent UnityEvents (select a control to see its wiring in the Inspector).\n<color=#FAB84C>\xBB</color> 
    <b>Verification:</b> Drag the slider: 'Deferred save' counts the changes and
    the stored value updates once after the drag. Framerate cap and VSync change
    the engine immediately.\n<color=#FAB84C>\xBB</color>  Slider -> GameSettingsComponent.SetMouseSensitivityForMenu
    (NoCode, Deferred save)\n<color=#FAB84C>\xBB</color>  Drag fast: many changes,
    one SaveProvider write after 0.35 s idle\n<color=#FAB84C>\xBB</color>  Save ->
    FlushPendingSettingsSave; Reset -> ResetGroup per group"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
