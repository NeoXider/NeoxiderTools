  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#FF9933>\xBB</color>  <b>Runtime API:</b> parallaxLayer.SetTargetCamera(camera);
    TargetCamera. Multiplier, scrollSpeed, tiling, spacing and sprite variants are
    Inspector settings.\n<color=#FF9933>\xBB</color>  <b>Scene workflow:</b> Select
    a band under [Demo] World / Band \xB7 */Layer to see its ParallaxLayer (Target
    Camera, Parallax Multiplier, Scroll Speed). Edit-mode preview shows the tiles.\n<color=#FF9933>\xBB</color> 
    <b>Verification:</b> Enter Play Mode: the camera pans, deeper bands move slower,
    clouds drift even with Auto pan off, and jumps of 25 units leave no gaps.\n<color=#FF9933>\xBB</color> 
    Pan speed / Auto pan / Reverse / Jump -> ParallaxDemoController moves the camera\n<color=#FF9933>\xBB</color> 
    Every band reads the camera delta in LateUpdate and recycles its tiles\n<color=#FF9933>\xBB</color> 
    Clouds: scrollSpeed adds motion of their own"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
