MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1593052455}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2f9eb3d1945ff1640a88058f7d4f2b42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Neo.Rpg.Demo::Neo.Samples.ModuleDemoSceneInfo
  _moduleName: "Example game \xB7 Clicker"
  _purpose: 'A complete clicker built only from library components and UnityEvents,
    without game scripts: earn coins on the pizza, spend them on skins in the shop.'
  _runtimeApi: Money.Add(amount) / TrySpend, Shop.Buy(index) / TryBuy(itemId), UI.SetPage(index),
    InteractiveObject events.
  _sceneWorkflow: Pizza = InteractiveObject + Animator + ShopItem; Shop = Shop with
    its ShopItemData skins; Canvas = UI pages; --System-- = Money and the other managers.
  _verification: 'Click the pizza (left or right) or press E: coins rise. SHOP opens
    the list: buy a skin and the pizza changes. Coins and skins are saved under the
    demo keys NeoDemo.Clicker.Money / NeoDemo.Clicker.Shop.'
  _showRuntimeOverlay: 1
  _corner: 0
  _accentColor: {r: 0.98, g: 0.72, b: 0.3, a: 1}
  _backgroundColor: {r: 0.11764706, g: 0.11764706, b: 0.15686275, a: 0.8509804}
  _panelWidth: 440
  _startCollapsed: 0
  _hints:
  - 'Pizza: InteractiveObject onInteractDown / onRightClick -> Money.Add(1), onClick
    -> Animator.SetTrigger(Click)'
  - '--System--/Money: Money wallet; its T_money text list shows the coin count'
  - 'Shop: one ShopItem per ShopItemData in the scroll list; its buttons -> Shop.Buy(index)
    (Auto Subscribe)'
  - 'Pizza ShopItem = the shop preview: the selected skin is drawn on its sprite'
  - 'Canvas: UI pages Game / Shop; SHOP and Cancel -> UI.SetPage(1 / 0)'
  _overlayRoot: {fileID: 1614954297}
  _titleLabel: {fileID: 1065997132}
  _descriptionLabel: {fileID: 579095128}
  _hintsLabel: {fileID: 1734372745}
  _collapseLabel: {fileID: 895370926}
  _collapsibleParts:
  - {fileID: 1362494808}
  - {fileID: 1272457827}
