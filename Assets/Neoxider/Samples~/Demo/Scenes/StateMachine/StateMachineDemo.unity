  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#33CCBF>\xBB</color>  <b>Runtime API:</b> new StateMachine<IState>();
    ChangeState(state); Update(); OnStateChanged. Behaviour: ChangeState(stateData),
    ChangeState(\"Alert\"), GoToInitialState().\n<color=#33CCBF>\xBB</color>  <b>Scene
    workflow:</b> Select 'Guard': State Machine Data = Guard StateMachine.asset;
    Context Overrides = Noise toggle, Sleep Look, Alert Look (slots Override1..3).\n<color=#33CCBF>\xBB</color> 
    <b>Verification:</b> Play: the Agent goes Idle -> Patrol; Provoke sends it after
    the yellow ring. Noise on turns the Guard pink (Alert).\n<color=#33CCBF>\xBB</color> 
    Provoke / Calm -> StateMachineDemoController -> machine.ChangeState (C#)\n<color=#33CCBF>\xBB</color> 
    Force Alert -> Guard.ChangeState(StateData) (NoCode)\n<color=#33CCBF>\xBB</color> 
    Guard.OnStateChanged -> controller log"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
