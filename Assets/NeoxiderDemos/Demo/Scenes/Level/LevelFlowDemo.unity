  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2f9eb3d1945ff1640a88058f7d4f2b42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Neo.Rpg.Demo::Neo.Samples.ModuleDemoSceneInfo
  _moduleName: Neo.Core.Level + Neo.Level
  _purpose: LevelComponent turns XP into levels through a LevelCurveDefinition asset
    and saves its profile. LevelManager tracks maps, the selected level and the cleared
    frontier per map; LevelButtons and TextLevel show it without code.
  _runtimeApi: LevelComponent.AddXp / SetLevel / ResetProgress, LevelState / XpState
    / XpToNextLevelState, OnLevelUp; LevelManager.SaveLevel / NextLevel / SetMapId,
    Map.IsComplete.
  _sceneWorkflow: '[Demo] Services/Player Level holds the LevelComponent and the
    two LevelNoCodeActions; ''Level Demo'' holds LevelManager (World 1: 5 levels,
    Endless: infinite). Labels, grid and buttons are wired with persistent UnityEvents.'
  _verification: '+XP fills the bar and levels up; Complete level unlocks the next
    grid cell; after 5 clears Map.IsComplete is YES. Stop and re-enter Play Mode:
    XP and progress return.'
  _showRuntimeOverlay: 1
  _corner: 0
  _accentColor: {r: 0.49, g: 0.36, b: 0.94, a: 1}
  _backgroundColor: {r: 0.11764706, g: 0.11764706, b: 0.15686275, a: 0.8509804}
  _panelWidth: 460
  _startCollapsed: 0
  _hints:
  - Player Level -> LevelState.OnChanged -> DemoValueReadout (NoCode label)
  - 'Level 1..5 cells: LevelButton events toggle Lock / Next / Done'
  - Complete level -> LevelManager.SaveLevel; Endless map has no grid
  _overlayRoot: {fileID: 1911679883}
  _titleLabel: {fileID: 334331563}
  _descriptionLabel: {fileID: 1109034521}
  _hintsLabel: {fileID: 1660631232}
  _collapseLabel: {fileID: 1293335567}
  _collapsibleParts:
  - {fileID: 1980978361}
  - {fileID: 1389583250}
