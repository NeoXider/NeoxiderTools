  m_Script: {fileID: 11500000, guid: 2f9eb3d1945ff1640a88058f7d4f2b42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Neo.Rpg.Demo::Neo.Samples.ModuleDemoSceneInfo
  _moduleName: "Neo.Editor \xB7 Inspector attributes"
  _purpose: 'AttributeTest on ''Attribute'' declares its references with attributes.
    Select it: the Neo inspector fills them, checks [RequireInterface], tints [GUIColor]
    rows and draws [Button] methods. The result is saved in the scene, so Play Mode
    does no lookups.'
  _runtimeApi: 'The same lookups in C#: GetComponent<T>(), GetComponentsInChildren<T>(),
    Object.FindObjectsByType<T>(), FindFirstObjectByType<T>(). [Button] methods are
    plain methods.'
  _sceneWorkflow: 'Clear ''Cam Find In Scene'' on Attribute: the inspector refills
    it at once and Edit > Undo History lists ''Find attributed component''. Neoxider/Settings
    > Enable Attribute Search turns auto-fill off.'
  _verification: 'Play: Compare with C# reports 6 / 6 fields equal the C# queries;
    Kick bodies pushes the bodies of rbsFindAllInScene.'
  _showRuntimeOverlay: 1
  _corner: 0
  _accentColor: {r: 0.64, g: 0.5, b: 1, a: 1}
  _backgroundColor: {r: 0.11764706, g: 0.11764706, b: 0.15686275, a: 0.8509804}
  _panelWidth: 400
  _startCollapsed: 0
  _hints:
  - 'Actions on Attribute: set parameters, press Say or Get Money; output goes to
    the Console.'
  - 'Select Attribute and [Demo] Inspector/Attribute B, press Add Score: both scores
    change, one Ctrl+Z reverts them.'
  _overlayRoot: {fileID: 101425536}
  _titleLabel: {fileID: 650932835}
  _descriptionLabel: {fileID: 1839380375}
  _hintsLabel: {fileID: 1921316788}
  _collapseLabel: {fileID: 1931693073}
  _collapsibleParts:
  - {fileID: 642717203}
  - {fileID: 373783679}
