{
  "schema": 1,
  "config": "config.json",
  "inputs": {
    "html": [
      "input/pages/*.html"
    ]
  },
  "output": {
    "root": "out",
    "assemble": "perFile",
    "folders": {
      "uxml": "Screens",
      "uss": "Screens",
      "shared": "Shared",
      "strings": "Localization",
      "components": "Components"
    },
    "perFile": {
      "input/pages/a.html": {
        "name": "Alpha",
        "folder": "Screens/Main"
      }
    }
  }
}
