  m_Script: {fileID: 11500000, guid: 2f9eb3d1945ff1640a88058f7d4f2b42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Neo.Rpg.Demo::Neo.Samples.ModuleDemoSceneInfo
  _moduleName: "Neo.Settings \xB7 GameSettings"
  _purpose: Static GameSettings facade backed by a GameSettingsComponent service.
    Every control calls the real Set* API, applies to the engine and persists through
    SaveProvider under the demo prefix Neo.Demo.Settings..
  _runtimeApi: GameSettings.SetMouseSensitivity / SetGraphicsPreset / SetFramerateCap
    / SetVSync / ResetGroup / FlushPendingSettingsSave; GameSettingsComponent.HasPendingDeferredSave.
  _sceneWorkflow: One GameSettingsComponent per scene; UI controls call it through
    persistent UnityEvents (select a control to see its wiring in the Inspector).
  _verification: 'Drag the slider: ''Deferred save'' counts the changes and the stored
    value updates once after the drag. Framerate cap and VSync change the engine
    immediately.'
  _showRuntimeOverlay: 1
  _corner: 0
  _accentColor: {r: 0.98, g: 0.72, b: 0.3, a: 1}
  _backgroundColor: {r: 0.11764706, g: 0.11764706, b: 0.15686275, a: 0.8509804}
  _panelWidth: 460
  _startCollapsed: 0
  _hints:
  - Slider -> GameSettingsComponent.SetMouseSensitivityForMenu (NoCode, Deferred
    save)
  - 'Drag fast: many changes, one SaveProvider write after 0.35 s idle'
  - Save -> FlushPendingSettingsSave; Reset -> ResetGroup per group
  _overlayRoot: {fileID: 1589789421}
  _titleLabel: {fileID: 974395660}
  _descriptionLabel: {fileID: 298425312}
  _hintsLabel: {fileID: 363594982}
  _collapseLabel: {fileID: 1423215639}
  _collapsibleParts:
  - {fileID: 556410864}
  - {fileID: 799245145}
