.htu-root {
    flex-grow: 1;
    min-width: 0;
    padding: 6px;
}

.htu-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    flex-shrink: 0;
}

.htu-grow {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.htu-toolbar {
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.35);
}

.htu-job-field {
    flex-grow: 1;
    min-width: 220px;
}

.htu-job-field > .unity-base-field__label {
    min-width: 30px;
    width: 30px;
}

.htu-job-label {
    margin: 4px 2px;
    white-space: normal;
    flex-shrink: 0;
}

.htu-tabs {
    margin-bottom: 4px;
}

.htu-tab {
    flex-grow: 1;
    min-height: 26px;
}

.htu-tab--selected {
    -unity-font-style: bold;
    border-bottom-width: 2px;
    border-bottom-color: rgb(80, 160, 255);
    background-color: rgba(80, 160, 255, 0.18);
}

.htu-tab-panel {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    min-width: 0;
}

.htu-tab-content {
    flex-grow: 1;
    min-width: 0;
    padding-right: 4px;
}

.htu-tab-panel .unity-base-field {
    min-width: 0;
    flex-shrink: 1;
}

.htu-option-row > .unity-base-field {
    flex-grow: 1;
    min-width: 200px;
}

.htu-tab-panel .unity-base-field__label {
    min-width: 100px;
}

.htu-runner-details {
    min-height: 100px;
    margin-top: 4px;
}

.htu-runner-details .unity-text-field__input {
    white-space: normal;
}

.htu-narrow .htu-job-field,
.htu-narrow .htu-output-row > TextField,
.htu-narrow .htu-option-row > .unity-base-field {
    width: 100%;
    min-width: 0;
}

.htu-narrow .htu-inputs > .htu-row > TextField {
    min-width: 160px;
}

.htu-narrow .htu-location {
    min-width: 90px;
    width: 90px;
    overflow: hidden;
    text-overflow: ellipsis;
}

.htu-title {
    -unity-font-style: bold;
    margin-right: 8px;
    min-width: 56px;
}

.htu-subtitle {
    -unity-font-style: bold;
    margin-top: 6px;
    margin-bottom: 2px;
}

.htu-summary {
    margin-top: 2px;
    margin-bottom: 4px;
    opacity: 0.85;
    white-space: normal;
    flex-shrink: 0;
}

.htu-inputs {
    flex-grow: 1;
    min-height: 300px;
    min-width: 0;
    padding: 4px;
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.35);
    border-radius: 3px;
}

.htu-inputs.htu-drop {
    border-color: rgb(80, 160, 255);
    background-color: rgba(80, 160, 255, 0.12);
}

.htu-sources {
    height: 96px;
    flex-shrink: 0;
    margin-top: 4px;
}

.htu-files {
    flex-grow: 1;
    min-height: 120px;
}

.htu-source-row .htu-kind {
    min-width: 34px;
    opacity: 0.7;
}

.htu-source-row,
.htu-file-row,
.htu-findings .unity-list-view__item,
.htu-findings .unity-collection-view__item {
    flex-wrap: nowrap;
}

.htu-source-row .htu-grow,
.htu-file-row .htu-grow,
.htu-findings .unity-list-view__item .htu-grow {
    overflow: hidden;
    text-overflow: ellipsis;
}

.htu-source-row.htu-empty .unity-label {
    color: rgb(230, 170, 60);
}

.htu-count {
    min-width: 44px;
    -unity-text-align: middle-right;
    opacity: 0.8;
}

.htu-remove {
    width: 20px;
    height: 18px;
    padding: 0;
    margin: 0 0 0 4px;
}

.htu-badge {
    min-width: 42px;
    height: 16px;
    margin-right: 6px;
    padding: 0 4px;
    border-radius: 8px;
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
}

.htu-badge--pass {
    background-color: rgb(52, 140, 82);
}

.htu-badge--warn {
    background-color: rgb(196, 138, 20);
}

.htu-badge--fail {
    background-color: rgb(190, 60, 60);
}

.htu-badge--notrun {
    background-color: rgb(110, 110, 110);
}

.htu-rule {
    min-width: 40px;
    margin-right: 6px;
    -unity-font-style: bold;
}

.htu-location {
    min-width: 170px;
    margin-right: 8px;
    opacity: 0.75;
}

.htu-findings {
    flex-grow: 1;
    min-height: 300px;
    min-width: 0;
    padding: 4px;
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.35);
    border-radius: 3px;
}

.htu-detail {
    flex-shrink: 0;
    margin-top: 4px;
    padding: 4px;
    background-color: rgba(128, 128, 128, 0.12);
    border-radius: 3px;
}

.htu-detail-line {
    margin-bottom: 2px;
}

.htu-section {
    flex-shrink: 0;
    margin-top: 6px;
    padding: 4px;
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.35);
    border-radius: 3px;
}

.htu-action-bar {
    margin-top: 6px;
    flex-shrink: 0;
}

.htu-action-bar Button {
    min-width: 110px;
    margin-right: 4px;
}

.htu-primary {
    -unity-font-style: bold;
    border-width: 1px;
    border-color: rgb(80, 160, 255);
    background-color: rgba(80, 160, 255, 0.18);
}

.htu-status {
    margin: 4px 2px;
    white-space: normal;
    flex-shrink: 1;
    -unity-font-style: bold;
}

.htu-status--pass {
    color: rgb(80, 190, 110);
}

.htu-status--warn {
    color: rgb(230, 170, 60);
}

.htu-status--fail {
    color: rgb(235, 90, 90);
}

.htu-progress {
    width: 140px;
    margin-left: 8px;
}

.htu-note {
    margin-top: 2px;
    white-space: normal;
    opacity: 0.8;
    max-height: 56px;
    overflow: hidden;
}
