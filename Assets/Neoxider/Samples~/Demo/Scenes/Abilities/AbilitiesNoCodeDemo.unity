  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#7D5CF0>\xBB</color>  <b>Runtime API:</b> AbilityCasterBehaviour.TryCastAtUnit
    / Cast(CastRequest) -> CastResult, GetCooldownNormalized; AbilityUnitBehaviour.SetLevel
    / ApplyDamage / ApplyHeal.\n<color=#7D5CF0>\xBB</color>  <b>Scene workflow:</b>
    Buttons -> AbilityNoCodeAction.Execute; bars -> SetProgress on HealthNormalized
    and AbilityCooldownSource; Auto Zap toggle -> AbilityAutoCaster.enabled.\n<color=#7D5CF0>\xBB</color> 
    <b>Verification:</b> Hit 20 then Heal (+15), a second Heal is rejected by the
    cooldown, Zap deals 12 / 20 / 30 at levels 1 / 2 / 3, Reset restores both units.\n<color=#7D5CF0>\xBB</color> 
    Btn_Hit Player 20 / Btn_Cast Heal: Button + AbilityNoCodeAction\n<color=#7D5CF0>\xBB</color> 
    Player: unit, caster, auto-caster, cooldown source; TrainingDummy: unit\n<color=#7D5CF0>\xBB</color> 
    Player / TrainingDummy On Damaged -> AbilitiesDemoGuide (persistent)\n<color=#7D5CF0>\xBB</color> 
    Assets: Scenes/Abilities/Assets (DemoUnit, TrainingDummyUnit, Zap, HealPulse)"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
