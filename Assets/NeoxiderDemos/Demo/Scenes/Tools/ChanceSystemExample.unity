  m_Script: {fileID: 11500000, guid: 2f9eb3d1945ff1640a88058f7d4f2b42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Neo.Rpg.Demo::Neo.Samples.ModuleDemoSceneInfo
  _moduleName: "Neo.Tools.Random \xB7 ChanceSystem"
  _purpose: 'Weighted loot rolls. ''Chance'' (ChanceSystemBehaviour) owns the table:
    the left column reacts only through its persistent UnityEvents, the right column
    samples the same odds from C# and rolls exact integer odds.'
  _runtimeApi: "ChanceManager.TryEvaluate / GetNormalizedWeight \xB7 ChanceSystemBehaviour.GenerateId
    \xB7 IntegerChanceTable.Roll / TryGetOdds / GetIndex(ticket)."
  _sceneWorkflow: 'Select ''Chance'': Events By Index[i] lights tile i and writes
    Last drop; OnIdGenerated clears the highlight, writes Index and calls ChanceDemoController.RecordRoll.'
  _verification: 'Play: Roll a few times, then Sample 1,000 - the bars settle on
    the white expected markers. Ten Draw 100,000 presses average one jackpot.'
  _showRuntimeOverlay: 1
  _corner: 0
  _accentColor: {r: 1, g: 0.76, b: 0.27, a: 1}
  _backgroundColor: {r: 0.11764706, g: 0.11764706, b: 0.15686275, a: 0.8509804}
  _panelWidth: 460
  _startCollapsed: 0
  _hints:
  - Btn_Roll -> ChanceSystemBehaviour.GenerateVoid + Counter.Add(1) (NoCode)
  - Events By Index -> tile Selected.SetActive + SetText.Set (NoCode)
  - Sample / Draw -> ChanceDemoController -> ChanceManager / IntegerChanceTable (C#)
  _overlayRoot: {fileID: 667154944}
  _titleLabel: {fileID: 1328998764}
  _descriptionLabel: {fileID: 952615092}
  _hintsLabel: {fileID: 1808273083}
  _collapseLabel: {fileID: 559508042}
  _collapsibleParts:
  - {fileID: 181342318}
  - {fileID: 1142266571}
