  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#FFB840>\xBB</color>  <b>Runtime API:</b> manager.TryAcceptQuest
    / AddObjectiveProgress / NotifyKill(id, n) / NotifyCollect / NotifyTalk / NotifyReachPoint
    / FailQuest / RestartQuest; C# events QuestAccepted, ObjectiveProgress, QuestCompleted.\n<color=#FFB840>\xBB</color> 
    <b>Scene workflow:</b> [Demo] Services: Quest Manager (Known Quests = Data/Quest
    assets), Gold Wallet (Money), Quest NoCode Actions (one QuestNoCodeAction per
    world button).\n<color=#FFB840>\xBB</color>  <b>Verification:</b> Play: Wolf
    Hunt -> Accept -> Kill 3 wolves completes it and pays 25 gold. States persist
    between sessions; Reset all replays.\n<color=#FFB840>\xBB</color>  Journal buttons
    -> QuestDemoController (C# API)\n<color=#FFB840>\xBB</color>  World buttons ->
    QuestNoCodeAction.Execute (NoCode, by Target Id)\n<color=#FFB840>\xBB</color> 
    Quest Manager \u203A On Quest Completed -> Money.Add (reward without code)"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
