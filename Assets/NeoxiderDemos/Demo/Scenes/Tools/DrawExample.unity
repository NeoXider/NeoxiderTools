  m_Name: 
  m_EditorClassIdentifier: Neo.Rpg.Demo::Neo.Samples.ModuleDemoSceneInfo
  _moduleName: "Neo.Tools \xB7 Drawer"
  _purpose: Draw lines with the mouse. Each stroke is Chaikin-smoothed live, gets
    an EdgeCollider2D and deletes itself after a few seconds; SimpleSpawner drops
    balls that bounce off it.
  _runtimeApi: drawer.BeginLine(p), AppendPoint(p), EndLine(), DeleteLast(), DeleteAll();
    reactive PointCount and Distance; OnLineStarted(Vector3), OnLineCreated(LineRenderer).
  _sceneWorkflow: 'Select Draw: every setting is an Inspector field. PointCount.OnChanged
    and Distance.OnChanged feed the value labels; Undo and Clear call Drawer directly.'
  _verification: 'Drag in the scene: Points and Length count while drawing, release
    logs OnLineCreated. Smoothing, width and collider apply to the next stroke.'
  _showRuntimeOverlay: 1
  _corner: 0
  _accentColor: {r: 0.95, g: 0.45, b: 0.88, a: 1}
  _backgroundColor: {r: 0.11764706, g: 0.11764706, b: 0.15686275, a: 0.8509804}
  _panelWidth: 400
  _startCollapsed: 0
