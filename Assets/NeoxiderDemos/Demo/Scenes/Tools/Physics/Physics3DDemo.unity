  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2f9eb3d1945ff1640a88058f7d4f2b42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Neo.Rpg.Demo::Neo.Samples.ModuleDemoSceneInfo
  _moduleName: "Neo.Tools \xB7 Physics 3D"
  _purpose: 'Three ready 3D physics emitters on plain Rigidbodies, set up in the
    Inspector and driven by persistent listeners: MagneticField pulls and pushes
    the steel balls, ImpulseZone keeps three balls bouncing through a trigger field,
    ExplosiveForce throws the crate pyramid.'
  _runtimeApi: magnet.SetStrength / SetMode / enabled / OnModeChanged; pad.SetImpulseForce
    / ApplyImpulseToObject(go) / OnImpulseApplied; mine.Explode() / Explode(force)
    / OnExplode / OnObjectAffected.
  _sceneWorkflow: '[Demo] World: Magnet (MagneticField, Toggle 2.2 s pull / 0.45
    s push), Impulse Field (trigger BoxCollider + ImpulseZone, Custom up, over an
    elastic Bounce Plate), Mine (ExplosiveForce, Manual). The card''s controls call
    these components directly.'
  _verification: 'Play: the magnet pulses on its own; the field speeds the balls
    up on the way up and slows them on the way down, so they keep bouncing (Kick
    revives a ball that stopped). Detonate and Mega blast throw the crates; restart
    Play to restack them.'
  _showRuntimeOverlay: 1
  _corner: 0
  _accentColor: {r: 0.36, g: 0.8, b: 1, a: 1}
  _backgroundColor: {r: 0.11764706, g: 0.11764706, b: 0.15686275, a: 0.8509804}
  _panelWidth: 400
  _startCollapsed: 0
  _hints:
  - "Strength slider \u203A MagneticField.SetStrength (dynamic float)"
  - "Kick the balls \u203A ImpulseZone.ApplyImpulseToObject(ball)"
  - "Mega blast \u203A ExplosiveForce.Explode(18)"
  _overlayRoot: {fileID: 830889568}
  _titleLabel: {fileID: 582897602}
  _descriptionLabel: {fileID: 1092842488}
  _hintsLabel: {fileID: 924587104}
  _collapseLabel: {fileID: 1419557917}
  _collapsibleParts:
  - {fileID: 66451167}
  - {fileID: 412520412}
