  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2f9eb3d1945ff1640a88058f7d4f2b42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Neo.Rpg.Demo::Neo.Samples.ModuleDemoSceneInfo
  _moduleName: "Neo.Condition \xB7 NeoCondition"
  _purpose: 'Rules without code: each NeoCondition reads a component value, compares
    it and fires OnTrue / OnFalse / OnResult. Here they read Health and ScoreManager.'
  _runtimeApi: condition.Evaluate() (no events), Check(), AddCondition(entry), entry.TryEvaluate(owner,
    out bool); events OnTrue, OnFalse, OnResult(bool).
  _sceneWorkflow: 'Select ''CheckDead'', ''CheckLowHP'' (under ''Health'') or ''CheckWin''
    (under ''Score''): the Conditions list and OnResult listeners drive the lamps,
    banners and badge.'
  _verification: 'Play: damage the player to 30 HP or less (LOW HP badge), then to
    0 (Game Over); add score up to 100 (You Win). Reset restores both.'
  _showRuntimeOverlay: 1
  _corner: 0
  _accentColor: {r: 0.36, g: 0.86, b: 0.62, a: 1}
  _backgroundColor: {r: 0.11764706, g: 0.11764706, b: 0.15686275, a: 0.8509804}
  _panelWidth: 440
  _startCollapsed: 0
  _hints:
  - Buttons -> Health.TakeDamage / Heal, ScoreManager.Add (NoCode)
  - NeoCondition.OnResult -> GameObject.SetActive (lamp, banner)
  - Evaluate in code -> ConditionDemoUI -> NeoCondition.Evaluate() (C#)
  _overlayRoot: {fileID: 1194417287}
  _titleLabel: {fileID: 723238503}
  _descriptionLabel: {fileID: 1739128076}
  _hintsLabel: {fileID: 11915430}
  _collapseLabel: {fileID: 2092933696}
  _collapsibleParts:
  - {fileID: 1386309694}
  - {fileID: 1078394549}
