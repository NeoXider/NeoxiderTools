  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#5CDB9E>\xBB</color>  <b>Runtime API:</b> condition.Evaluate()
    (no events), Check(), AddCondition(entry), entry.TryEvaluate(owner, out bool);
    events OnTrue, OnFalse, OnResult(bool).\n<color=#5CDB9E>\xBB</color>  <b>Scene
    workflow:</b> Select 'CheckDead', 'CheckLowHP' (under 'Health') or 'CheckWin'
    (under 'Score'): the Conditions list and OnResult listeners drive the lamps,
    banners and badge.\n<color=#5CDB9E>\xBB</color>  <b>Verification:</b> Play: damage
    the player to 30 HP or less (LOW HP badge), then to 0 (Game Over); add score
    up to 100 (You Win). Reset restores both.\n<color=#5CDB9E>\xBB</color>  Buttons
    -> Health.TakeDamage / Heal, ScoreManager.Add (NoCode)\n<color=#5CDB9E>\xBB</color> 
    NeoCondition.OnResult -> GameObject.SetActive (lamp, banner)\n<color=#5CDB9E>\xBB</color> 
    Evaluate in code -> ConditionDemoUI -> NeoCondition.Evaluate() (C#)"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
