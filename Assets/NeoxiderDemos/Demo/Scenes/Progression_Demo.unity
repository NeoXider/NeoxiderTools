  m_Script: {fileID: 11500000, guid: 2f9eb3d1945ff1640a88058f7d4f2b42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Neo.Rpg.Demo::Neo.Samples.ModuleDemoSceneInfo
  _moduleName: "Neo.Progression \xB7 ProgressionManager"
  _purpose: 'LevelComponent turns XP into levels; ProgressionManager adds meta progression
    on top: a reward track pays perk points per level, perks cost points, unlock
    nodes gate content and premium opens a second reward lane.'
  _runtimeApi: levelComponent.AddXp(n); progression.TryUnlockNode / TryBuyPerk(id,
    out reason) / ActivatePremium() / ResetProgression(); C# events NodeUnlocked,
    PerkPurchased, PremiumActivated.
  _sceneWorkflow: 'ProgressionDemoManager: LevelComponent + ProgressionManager with
    the Data/Progression assets. [Demo] Services/Progression NoCode Actions: one
    ProgressionNoCodeAction per button.'
  _verification: 'Play: +500 XP levels up and pays perk points; unlock Forge at level
    2, buy Swift Feet then Blade Master; Activate Premium pays premium entries of
    reached levels.'
  _showRuntimeOverlay: 1
  _corner: 0
  _accentColor: {r: 0.26, g: 0.85, b: 0.64, a: 1}
  _backgroundColor: {r: 0.11764706, g: 0.11764706, b: 0.15686275, a: 0.8509804}
  _panelWidth: 460
  _startCollapsed: 0
  _hints:
  - XP buttons -> ProgressionDemoUI.AddXp -> LevelComponent.AddXp (C#)
  - Right column -> ProgressionNoCodeAction.Execute (NoCode, no scripts)
  - 'Perk points / Total XP labels: NoCodeBindText on reactive state'
  - LevelComponent.OnLevelUp and ProgressionManager events -> ProgressionDemoUI
  _overlayRoot: {fileID: 286793355}
  _titleLabel: {fileID: 1547501369}
  _descriptionLabel: {fileID: 1838958847}
  _hintsLabel: {fileID: 1671584951}
  _collapseLabel: {fileID: 705975076}
  _collapsibleParts:
