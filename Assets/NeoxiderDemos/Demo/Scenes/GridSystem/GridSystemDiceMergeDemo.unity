--- !u!114 &3002
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3000}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2f9eb3d1945ff1640a88058f7d4f2b42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _moduleName: "Neo.GridSystem \xB7 Dice Merge"
  _purpose: "A 5\xD75 dice merge puzzle from GridSystem blocks: DiceBoardService
    places single dice and pairs on a FieldGenerator field and merges three or more
    equal neighbours into a higher die. Drag the next piece from the tray onto the
    board; a quick tap rotates a pair."
  _runtimeApi: DiceBoardService.Place / CanPlace / CanPlaceAnywhere / TryFindPlacement
    / MinMergeGroupSize, DicePieceGenerator.Generate, DicePiece.RotateClockwise.
  _sceneWorkflow: "Select GridSystem_DiceMerge: FieldGenerator (5\xD75), DiceBoardService
    (merge group, step, cap), DiceMergeDemoController (game loop) and DiceMergeDemoView
    (art and prefabs)."
  _verification: 'Play: place dice, merge three equal neighbours to score; when the
    next piece fits nowhere (CanPlaceAnywhere) the run is over - press Restart.'
  _showRuntimeOverlay: 1
  _corner: 0
  _accentColor: {r: 0.98, g: 0.72, b: 0.3, a: 1}
  _backgroundColor: {r: 0.11764706, g: 0.11764706, b: 0.15686275, a: 0.8509804}
  _panelWidth: 420
  _startCollapsed: 0
  _hints:
  - Hint -> DiceBoardService.TryFindPlacement; the slider sets MinMergeGroupSize
    live.
  - DiceBoardService.OnMergesResolved -> DiceMergeDemoController.HandleMergesResolved
    (Inspector).
  - '[Demo] Board Preview shows the layout in Edit Mode; the view draws the real
    board on Play.'
  _overlayRoot: {fileID: 1311473600}
  _titleLabel: {fileID: 247728257}
  _descriptionLabel: {fileID: 78508813}
  _hintsLabel: {fileID: 295609452}
  _collapseLabel: {fileID: 861766936}
  _collapsibleParts:
  - {fileID: 1459930728}
  - {fileID: 787419090}
