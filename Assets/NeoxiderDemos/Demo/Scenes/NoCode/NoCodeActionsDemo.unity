  m_Name: 
  m_EditorClassIdentifier: Neo.Rpg.Demo::Neo.Samples.ModuleDemoSceneInfo
  _moduleName: "Neo.NoCode \xB7 Actions"
  _purpose: 'NoCode bridges turn module calls into components: each *NoCodeAction
    holds one typed call (AddXp, Accept, TakeDamage...) and exposes Execute() plus
    result events.'
  _runtimeApi: 'Same calls in C#: LevelComponent.AddXp, ProgressionManager.TryAddXp,
    QuestManager.AcceptQuest, RpgCharacter.Damage / Heal; bridge.Execute() from code.'
  _sceneWorkflow: 'Select a bridge (for example ''Level System/Bridge_AddXp''): action
    type and amount are Inspector fields; buttons call Execute(), result events write
    the labels.'
  _verification: 'Play: +XP raises the level, Accept then Complete finishes the quest,
    Take dmg lowers the HP bar.'
  _showRuntimeOverlay: 1
  _corner: 0
  _accentColor: {r: 0.3, g: 0.78, b: 0.98, a: 1}
  _backgroundColor: {r: 0.11764706, g: 0.11764706, b: 0.15686275, a: 0.8509804}
  _panelWidth: 440
  _startCollapsed: 0
  _hints:
  - Button.onClick -> *NoCodeAction.Execute()
  - OnResultMessage / OnSuccess -> result label and log
  - NoCodeFormattedText / SetProgress -> module values
  _overlayRoot: {fileID: 2053615798}
  _titleLabel: {fileID: 1981593589}
  _descriptionLabel: {fileID: 1990726308}
