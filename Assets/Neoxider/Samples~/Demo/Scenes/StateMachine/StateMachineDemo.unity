  m_Script: {fileID: 11500000, guid: 2f9eb3d1945ff1640a88058f7d4f2b42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Neo.Rpg.Demo::Neo.Samples.ModuleDemoSceneInfo
  _moduleName: Neo.StateMachine
  _purpose: 'Two ways to run states. Agent: a C# StateMachine<IState> with four state
    classes. Guard: a StateMachineBehaviourBase that plays a StateMachineData asset
    authored in the Inspector.'
  _runtimeApi: 'new StateMachine<IState>(); ChangeState(state); Update(); OnStateChanged.
    Behaviour: ChangeState(stateData), ChangeState("Alert"), GoToInitialState().'
  _sceneWorkflow: 'Select ''Guard'': State Machine Data = Guard StateMachine.asset;
    Context Overrides = Noise toggle, Sleep Look, Alert Look (slots Override1..3).'
  _verification: 'Play: the Agent goes Idle -> Patrol; Provoke sends it after the
    yellow ring. Noise on turns the Guard pink (Alert).'
  _showRuntimeOverlay: 1
  _corner: 1
  _accentColor: {r: 0.2, g: 0.8, b: 0.75, a: 1}
  _backgroundColor: {r: 0.11764706, g: 0.11764706, b: 0.15686275, a: 0.8509804}
  _panelWidth: 440
  _startCollapsed: 0
  _hints:
  - Provoke / Calm -> StateMachineDemoController -> machine.ChangeState (C#)
  - Force Alert -> Guard.ChangeState(StateData) (NoCode)
  - Guard.OnStateChanged -> controller log
  _overlayRoot: {fileID: 978883443}
  _titleLabel: {fileID: 390196568}
  _descriptionLabel: {fileID: 1415166576}
  _hintsLabel: {fileID: 316416275}
  _collapseLabel: {fileID: 345851302}
  _collapsibleParts:
