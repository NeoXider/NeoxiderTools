  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#FFC23D>\xBB</color>  <b>Runtime API:</b> slot.StartSpin() / AddBet
    / RemoveBet / SetMaxBet / AddLine / RemoveLine / ChanceWin / ForceNextOutcomeOnPayline
    / GetLastResult(); SlotSpinMath for price and payout.\n<color=#FFC23D>\xBB</color> 
    <b>Scene workflow:</b> Select Canvas/SlotUI: Money Game Object = [Demo] Services/Wallet
    (Money); Bets, Lines and Sprites Multiplier data live in Data/Bonus; its events
    drive the card labels.\n<color=#FFC23D>\xBB</color>  <b>Verification:</b> Play:
    Spin charges the price; three equal symbols on an active payline pay; Force a
    win queues a winning outcome on payline 1.\n<color=#FFC23D>\xBB</color>  Bet
    / Lines buttons -> SpinController.AddBet / RemoveBet / SetMaxBet / AddLine /
    RemoveLine\n<color=#FFC23D>\xBB</color>  OnChangeBet and OnChangeMoneyWin ->
    TMP_Text.SetText (no code)\n<color=#FFC23D>\xBB</color>  The SPIN button on the
    machine calls SpinController.StartSpin directly"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
