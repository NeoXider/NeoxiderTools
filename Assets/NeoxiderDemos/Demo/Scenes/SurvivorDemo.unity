  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#7D5CF0>\xBB</color>  <b>Runtime API:</b> Spawner (ring, weights,
    unlock, ramp, cap), MagneticField.OnObjectReached, LevelComponent.AddXp / OnLevelUp,
    ChanceSystemBehaviour.GenerateUnique / ConsumePick, AbilityNoCodeAction.Execute,
    AbilityUnitBehaviour.OnMoveSpeedChanged.\n<color=#7D5CF0>\xBB</color>  <b>Scene
    workflow:</b> Player = KeyboardMover + AbilityUnitBehaviour + AbilityAutoCaster
    + MagneticField; Enemy templates = AbilityUnitBehaviour + bite ability + Follow
    + Loot + Despawner; Services/Run holds XP Level, Kills, Survival Timer, Scene
    Flow and Upgrade Draft.\n<color=#7D5CF0>\xBB</color>  <b>Verification:</b> WASD
    to move; weapons fire by themselves; XP orbs fly to you and level you up; pick
    a card; survive 3 minutes to win.\n<color=#7D5CF0>\xBB</color>  [Demo] World/Player:
    OnMoveSpeedChanged -> KeyboardMover.SetSpeed; magnet -> AddXp + DespawnOther\n<color=#7D5CF0>\xBB</color> 
    [Demo] World/Templates/Enemy_*: OnDied -> Loot.DropLoot, Kills.Add(1), Despawner.Despawn\n<color=#7D5CF0>\xBB</color> 
    [Demo] Services/Run: OnLevelUp -> cards on, Pause, Upgrade Draft.GenerateUniqueVoid"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
