  m_Script: {fileID: 11500000, guid: 2f9eb3d1945ff1640a88058f7d4f2b42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Neo.Rpg.Demo::Neo.Samples.ModuleDemoSceneInfo
  _moduleName: "Neo.Abilities \xB7 Survivor kit"
  _purpose: 'A whole survivor loop as Neo.Abilities data: auto-cast weapons, a homing
    projectile, area bursts, slows, DoTs and level-up upgrades, all read from one
    SurvivorConfig.'
  _runtimeApi: AbilitySystem.Cast(CastRequest.AtUnit / NoTarget), GrantAbility, ApplyModifier;
    AbilitySystemBehaviour.Paused freezes cooldowns and DoTs on the level-up screen.
  _sceneWorkflow: Survivor Game holds the config; Ability System lists the library,
    the 'bolt' archetype and Spatial Cell Size 3 (grid queries for hundreds of units).
  _verification: WASD to move, weapons fire by themselves, XP orbs level you up;
    Level up now opens the card picker at once.
  _showRuntimeOverlay: 1
  _corner: 3
  _accentColor: {r: 0.49, g: 0.36, b: 0.94, a: 1}
  _backgroundColor: {r: 0.11764706, g: 0.11764706, b: 0.15686275, a: 0.8509804}
  _panelWidth: 400
  _startCollapsed: 0
  _hints:
  - '[Demo] World/Player: AbilityUnitBehaviour + SurvivorPlayerController'
  - '[Demo] World/Templates: pooled enemies, XP orb, projectile'
  - '[Demo] HUD: SurvivorHudView; cards -> SurvivorGame.PickUpgrade(i)'
  _overlayRoot: {fileID: 154675029}
  _titleLabel: {fileID: 853276057}
  _descriptionLabel: {fileID: 1009101914}
  _hintsLabel: {fileID: 773083096}
  _collapseLabel: {fileID: 226949413}
  _collapsibleParts:
  - {fileID: 967694410}
  - {fileID: 1176710413}
