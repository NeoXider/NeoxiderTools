  m_Name: 
  m_EditorClassIdentifier: Neo.Tools.Dialogue::Neo.Tools.DialogueLinePlayer
  lines:
  - tag: idle
    speaker: Blacksmith
    text: The forge never sleeps.
    weight: 1
    minTime: 0
    maxTime: 0
    slot: 0
  - tag: idle
    speaker: Blacksmith
    text: Steel or iron, friend?
    weight: 1
    minTime: 0
    maxTime: 0
    slot: 0
  - tag: idle
    speaker: Blacksmith
    text: Mind the sparks!
    weight: 1
    minTime: 0
    maxTime: 0
    slot: 0
  - tag: idle
    speaker: Blacksmith
    text: Still browsing? Take your time.
    weight: 1
    minTime: 15
    maxTime: 0
    slot: 0
  - tag: greet
    speaker: Blacksmith
    text: Welcome to my forge, stranger!
    weight: 1
    minTime: 0
    maxTime: 0
    slot: 1
  - tag: greet
    speaker: Blacksmith
    text: Back again? Need another blade?
    weight: 1
    minTime: 0
    maxTime: 0
    slot: 2
  - tag: greet
    speaker: Blacksmith
    text: Good to see you, friend.
    weight: 1
    minTime: 0
    maxTime: 0
    slot: 2
  - tag: hit
    speaker: Blacksmith
    text: Ow! Watch the hammer!
    weight: 1
    minTime: 0
    maxTime: 0
    slot: 0
  - tag: hit
    speaker: Blacksmith
    text: Hey, that's my good arm!
    weight: 1
    minTime: 0
    maxTime: 0
    slot: 0
  - tag: hit
    speaker: Blacksmith
    text: Careful, the metal is still hot!
    weight: 1
    minTime: 0
    maxTime: 0
    slot: 0
  avoidBackToBackRepeat: 1
