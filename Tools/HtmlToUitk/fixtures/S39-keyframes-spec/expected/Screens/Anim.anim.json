{
  "schema": 1,
  "animations": [
    {
      "id": "fade-in-up",
      "keyframes": "fade-in-up",
      "duration": 0.4,
      "delay": 0,
      "iterations": 1,
      "direction": "normal",
      "fill": "forwards",
      "easing": "ease-out",
      "steps": [
        {
          "offset": 0,
          "set": {
            "opacity": "0",
            "translate": "0 12px"
          }
        },
        {
          "offset": 1,
          "set": {
            "opacity": "1",
            "translate": "0 0"
          }
        }
      ]
    },
    {
      "id": "pulse",
      "keyframes": "pulse",
      "duration": 1,
      "delay": 0.2,
      "iterations": 3,
      "direction": "alternate",
      "fill": "none",
      "easing": "ease-in-out",
      "steps": [
        {
          "offset": 0,
          "set": {
            "scale": "1"
          }
        },
        {
          "offset": 0.5,
          "set": {
            "scale": "1.1"
          }
        },
        {
          "offset": 1,
          "set": {
            "scale": "1"
          }
        }
      ]
    }
  ],
  "bindings": [
    {
      "selector": ".an__card",
      "animation": "fade-in-up",
      "trigger": "onShow"
    },
    {
      "selector": ".an__pulse",
      "animation": "pulse",
      "trigger": "onShow"
    }
  ]
}
