  m_Name: 
  m_EditorClassIdentifier: Neo.Rpg.Demo::Neo.Samples.ModuleDemoSceneInfo
  _moduleName: "Neo.Tools \xB7 MouseEffect"
  _purpose: 'Three MouseEffect components listen to MouseInputManager: MouseEffectClick
    spawns circles, MouseEffectTrail drags a TrailRenderer and MouseEffectFollow
    shows a follower while the button is held.'
  _runtimeApi: MouseEffect fields spawnTrigger, spawnDuringHold, holdInterval, spawnLifetime;
    SetTargetCamera(cam); events onSpawn, onStartFollow, onStopFollow. MouseInputManager.I.OnPress
    / OnHold / OnRelease.
  _sceneWorkflow: '[Demo] Mouse Input holds the MouseInputManager with Enable Hold
    on (hold spawning needs it). The effect toggles call GameObject.SetActive on
    the Effects children directly.'
  _verification: 'Press and drag in the scene: circles, trail and follower appear;
    the log counts onSpawn.'
  _showRuntimeOverlay: 1
  _corner: 0
