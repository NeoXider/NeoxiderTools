  m_Script: {fileID: 11500000, guid: 2f9eb3d1945ff1640a88058f7d4f2b42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Neo.Rpg.Demo::Neo.Samples.ModuleDemoSceneInfo
  _moduleName: Neo.Tools.Dialogue
  _purpose: 'Linear conversations with DialogueController + DialogueUI (typewriter,
    portraits, events) and pooled barks with DialogueLinePlayer: lines by tag, no
    back-to-back repeats, first-pick slots, contextual lines interrupting idle chatter.'
  _runtimeApi: "DialogueController.StartDialogue / SkipOrNext / RestartAll, Typewriter.CharactersPerSecond
    \xB7 DialogueLinePool.TryPlay(tag, time, priority) / Finish."
  _sceneWorkflow: '''DialogueComponent'' holds the conversation (Dialogue -> Monolog
    -> Sentence) and drives the Dialogue Box''s DialogueUI; its events feed the Live
    column. Bark buttons call DialogueLinePlayer directly.'
  _verification: 'Play: the conversation types itself; click the box to finish a
    line, click again to advance. Press Idle line, then Hit! - the contextual line
    cuts in.'
  _showRuntimeOverlay: 1
  _corner: 0
  _accentColor: {r: 0.33, g: 0.83, b: 0.86, a: 1}
  _backgroundColor: {r: 0.11764706, g: 0.11764706, b: 0.15686275, a: 0.8509804}
  _panelWidth: 460
  _startCollapsed: 0
  _hints:
  - Dialogue Box / Btn_Skip or next -> DialogueController.SkipOrNext (NoCode)
  - "Btn_Idle line -> DialogueLinePlayer.RequestIdle \xB7 Btn_Hit! -> RequestContext(\"hit\")"
  - Toggles and speed -> DialogueDemoController -> DialogueController fields
  _overlayRoot: {fileID: 812495386}
  _titleLabel: {fileID: 1680604697}
  _descriptionLabel: {fileID: 2009162754}
  _hintsLabel: {fileID: 1327072302}
  _collapseLabel: {fileID: 1229414263}
  _collapsibleParts:
  - {fileID: 1258064610}
  - {fileID: 288887569}
