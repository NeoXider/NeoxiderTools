--- !u!114 &1734372745
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1734372743}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#FAB84C>\xBB</color>  <b>Runtime API:</b> Money.Add(amount) / TrySpend,
    Shop.Buy(index) / TryBuy(itemId), UI.SetPage(index), InteractiveObject events.\n<color=#FAB84C>\xBB</color> 
    <b>Scene workflow:</b> Pizza = InteractiveObject + Animator + ShopItem; Shop
    = Shop with its ShopItemData skins; Canvas = UI pages; --System-- = Money and
    the other managers.\n<color=#FAB84C>\xBB</color>  <b>Verification:</b> Click
    the pizza (left or right) or press E: coins rise. SHOP opens the list: buy a
    skin and the pizza changes. Coins and skins are saved under the demo keys NeoDemo.Clicker.Money
    / NeoDemo.Clicker.Shop.\n<color=#FAB84C>\xBB</color>  Pizza: InteractiveObject
    onInteractDown / onRightClick -> Money.Add(1), onClick -> Animator.SetTrigger(Click)\n<color=#FAB84C>\xBB</color> 
    --System--/Money: Money wallet; its T_money text list shows the coin count\n<color=#FAB84C>\xBB</color> 
    Shop: one ShopItem per ShopItemData in the scroll list; its buttons -> Shop.Buy(index)
    (Auto Subscribe)\n<color=#FAB84C>\xBB</color>  Pizza ShopItem = the shop preview:
    the selected skin is drawn on its sprite\n<color=#FAB84C>\xBB</color>  Canvas:
    UI pages Game / Shop; SHOP and Cancel -> UI.SetPage(1 / 0)"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
