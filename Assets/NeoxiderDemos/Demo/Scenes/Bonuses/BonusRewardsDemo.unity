--- !u!114 &1847826802
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1847826801}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2f9eb3d1945ff1640a88058f7d4f2b42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Neo.Rpg.Demo::Neo.Samples.ModuleDemoSceneInfo
  _moduleName: "Neo.Bonus \xB7 Rewards & Collection"
  _purpose: 'A reward loop made only of Bonus components and wired in the scene:
    CooldownReward gives a timed gift, the gift fills the Box chest, a full chest
    grants a random locked pizza from the Collection, and CollectionVisualManager
    redraws the ItemCollection slots.'
  _runtimeApi: collection.TryAddItem(i) / GetPrize() / ClearCollection() / Set; box.AddProgress()
    / TakePrize() / CheckProgress; gift.TakeReward() / CanTakeReward() / RemainingTime
    / SetRewardAvailableNow().
  _sceneWorkflow: '[Demo] Services: Pizza Collection (catalog in Data/Bonus/Pizzas),
    Gift (CooldownReward), Coins (TimeReward, legacy), Wallet (Money). The slot row
    holds the CollectionVisualManager, the chest row the Box, the details row the
    ItemCollectionInfo.'
  _verification: 'Play: Claim gift, Gift now, Claim gift until the chest shows 300/300,
    then Open chest: a random pizza unlocks and can be selected. Reset demo progress
    locks every pizza, empties the chest, makes both timers ready and zeroes the
    wallet; every key it writes stays under NeoDemo.*.'
  _showRuntimeOverlay: 1
  _corner: 0
  _accentColor: {r: 1, g: 0.66, b: 0.3, a: 1}
  _backgroundColor: {r: 0.11764706, g: 0.11764706, b: 0.15686275, a: 0.8509804}
  _panelWidth: 400
  _startCollapsed: 0
  _hints:
  - "Claim gift \u203A CooldownReward.Take \u203A OnRewardClaimed \u203A Box.AddProgress"
  - "Open chest \u203A Box.TakePrize \u203A Collection.GetPrize \u203A the slot unlocks"
  - "Unlocked slot \u203A CollectionVisualManager.OnSetItem \u203A ItemCollectionInfo.SetItemId"
  _overlayRoot: {fileID: 541608185}
  _titleLabel: {fileID: 1958169759}
  _descriptionLabel: {fileID: 1492030188}
  _hintsLabel: {fileID: 1716424497}
  _collapseLabel: {fileID: 822276498}
  _collapsibleParts:
  - {fileID: 589772076}
  - {fileID: 744012326}
