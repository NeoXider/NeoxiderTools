  m_Script: {fileID: 11500000, guid: 2f9eb3d1945ff1640a88058f7d4f2b42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Neo.Rpg.Demo::Neo.Samples.ModuleDemoSceneInfo
  _moduleName: "Neo.Bonus \xB7 SpinController"
  _purpose: "Slot machine: SpinController spins the reels, charges bet \xD7 paylines
    from a wallet, checks paylines (CheckSpin) and pays bet \xD7 multiplier for each
    winning line."
  _runtimeApi: slot.StartSpin() / AddBet / RemoveBet / SetMaxBet / AddLine / RemoveLine
    / ChanceWin / ForceNextOutcomeOnPayline / GetLastResult(); SlotSpinMath for price
    and payout.
  _sceneWorkflow: 'Select Canvas/SlotUI: Money Game Object = [Demo] Services/Wallet
    (Money); Bets, Lines and Sprites Multiplier data live in Data/Bonus; its events
    drive the card labels.'
  _verification: 'Play: Spin charges the price; three equal symbols on an active
    payline pay; Force a win queues a winning outcome on payline 1.'
  _showRuntimeOverlay: 1
  _corner: 0
  _accentColor: {r: 1, g: 0.76, b: 0.24, a: 1}
  _backgroundColor: {r: 0.11764706, g: 0.11764706, b: 0.15686275, a: 0.8509804}
  _panelWidth: 460
  _startCollapsed: 0
  _hints:
  - Bet / Lines buttons -> SpinController.AddBet / RemoveBet / SetMaxBet / AddLine
    / RemoveLine
  - OnChangeBet and OnChangeMoneyWin -> TMP_Text.SetText (no code)
  - The SPIN button on the machine calls SpinController.StartSpin directly
  _overlayRoot: {fileID: 378054843}
  _titleLabel: {fileID: 765228387}
  _descriptionLabel: {fileID: 890226562}
  _hintsLabel: {fileID: 1350758336}
  _collapseLabel: {fileID: 1488903510}
  _collapsibleParts:
  - {fileID: 528887301}
  - {fileID: 1412253999}
