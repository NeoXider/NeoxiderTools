  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#40C9F0>\xBB</color>  <b>Runtime API:</b> AM.I.Play(\"shot\") /
    PlayAt / PlayMusicPool(\"pads\") / NextMusicTrack / StopMusic / SetUiVolume;
    AMSettings.I.SetMusicVolume / SetEfx / SetMusic; events OnMusicStarted, OnRandomMusicTrackChanged,
    OnMusicStopped.\n<color=#40C9F0>\xBB</color>  <b>Scene workflow:</b> Select 'Audio
    Demo' to see the AM Sounds and Music lists (ids, clip sets, pitch, Loop / Shuffle
    pools); [Demo] Services holds AMSettings and MusicControl. Buttons, sliders and
    toggles are wired in their On Click / On Value Changed lists.\n<color=#40C9F0>\xBB</color> 
    <b>Verification:</b> Enter Play Mode: each sound button plays its entry, Theme
    loops, Pads shuffle with crossfades, and mutes/volumes survive a restart.\n<color=#40C9F0>\xBB</color> 
    Buttons -> AM.Play(id) directly (NoCode); 'UI click' is a PlayAudioBtn\n<color=#40C9F0>\xBB</color> 
    Music buttons -> MusicControl.PlayPool / NextTrack / StopMusic\n<color=#40C9F0>\xBB</color> 
    Sliders and toggles -> AMSettings (saved); MuteMusic/MuteEfx.OnChanged -> labels"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
