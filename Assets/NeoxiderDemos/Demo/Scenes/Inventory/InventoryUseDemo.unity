MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1657314620}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2f9eb3d1945ff1640a88058f7d4f2b42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Neo.Rpg.Demo::Neo.Samples.ModuleDemoSceneInfo
  _moduleName: "Neo.Tools.Inventory \xB7 select and use"
  _purpose: 'Three ordinary InventoryComponents in Slot Grid mode: a temporary catch,
    a nine-slot hotbar and a one-slot podium. Unique PET instances keep their UID
    and JSON state across transfers; InventoryHand + InventoryUseAction consume exactly
    one CELL from the selected slot.'
  _runtimeApi: "InventoryComponent.AddItemInstance / TryCaptureSelection / GetPhysicalSlotRecord
    \xB7 InventoryTransferService.TransferSelection \xB7 InventoryHand.SetSlotIndex
    / TryGetEquippedSelection / UseEquippedItem \xB7 InventoryUseAction.TryUse."
  _sceneWorkflow: Select 'Hotbar - nine permanent slots', 'Temporary catch - four
    slots', 'Podium - exact unique instance' and 'Inventory demo - select and use'
    (InventoryHand, InventoryUseAction, InventoryDemoController). Slot rows are InventorySlotGridView
    with manual InventorySlotView cells.
  _verification: 'Play: Deposit catch, select the PET slot and Use - it moves to
    the podium with the same UID; Recall brings it back. Take damage, select CELL,
    Use: +25 HP, one CELL consumed.'
  _showRuntimeOverlay: 1
  _corner: 0
  _accentColor: {r: 0.3, g: 0.85, b: 0.7, a: 1}
  _backgroundColor: {r: 0.11764706, g: 0.11764706, b: 0.15686275, a: 0.8509804}
  _panelWidth: 460
  _startCollapsed: 0
  _hints:
  - Btn_Slot N -> InventoryHand.SetSlotIndex(N-1) (NoCode); keys 1-9 do the same
  - InventoryHand.OnUseSelectionRequested -> InventoryUseAction.UseSelection -> OnUsed
    -> InventoryDemoController.OnCellUsed
  - 'Labels: InventoryTotalCountText (Total, Selected) and InventoryItemCountText
    - no code'
  _overlayRoot: {fileID: 1369742551}
  _titleLabel: {fileID: 577980114}
  _descriptionLabel: {fileID: 754504011}
  _hintsLabel: {fileID: 2025040012}
  _collapseLabel: {fileID: 2097741928}
  _collapsibleParts:
  - {fileID: 404425751}
  - {fileID: 2116644819}
