  m_Script: {fileID: 11500000, guid: 2f9eb3d1945ff1640a88058f7d4f2b42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Neo.Rpg.Demo::Neo.Samples.ModuleDemoSceneInfo
  _moduleName: "Neo.Cards \xB7 Drunkard"
  _purpose: A complete card game built only from Neo.Cards components and UnityEvents;
    the game itself has no demo scripts. Play a few rounds, then select the objects
    below.
  _runtimeApi: DeckComponent.Initialize / DrawCard, HandComponent.AddCardAsync, DrunkardGame.Play
    / RestartGame.
  _sceneWorkflow: CardManager = DrunkardGame, DECK = DeckComponent, Hand Player /
    Hand Bot = HandComponent, Board = BoardComponent.
  _verification: 'Tap to play, click through the dealer''s tips, then click your
    pile at the bottom: the higher card takes both, equal ranks start a war.'
  _showRuntimeOverlay: 1
  _corner: 0
  _accentColor: {r: 0.26, g: 0.85, b: 0.64, a: 1}
  _backgroundColor: {r: 0.11764706, g: 0.11764706, b: 0.15686275, a: 0.8509804}
  _panelWidth: 380
  _startCollapsed: 0
  _hints:
  - Your pile -> DrunkardGame.Play; score labels <- HandComponent.OnCardCountChanged
    -> SetText.
  - 'Bottom-right panel (after the tips): game events -> DemoLogFeed.Log, fixed shuffle
    seed + Restart deal.'
  _overlayRoot: {fileID: 1340805604}
  _titleLabel: {fileID: 1210914}
  _descriptionLabel: {fileID: 658200713}
  _hintsLabel: {fileID: 1381822825}
  _collapseLabel: {fileID: 2080236081}
  _collapsibleParts:
  - {fileID: 1319101778}
  - {fileID: 930493370}
