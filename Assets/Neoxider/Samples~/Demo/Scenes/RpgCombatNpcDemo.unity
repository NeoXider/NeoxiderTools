  m_Script: {fileID: 11500000, guid: 2f9eb3d1945ff1640a88058f7d4f2b42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Neo.Rpg.Demo::Neo.Samples.ModuleDemoSceneInfo
  _moduleName: "Neo.Rpg \xB7 Combat with NPCs"
  _purpose: 'Player (RpgCharacter + RpgAttackController + KeyboardMover) against
    2 NPCs: MeleeNpc deals RpgContactDamage, RangedNpc is driven by NpcRpgCombatBrain.
    HUD, health bars and log are scene objects.'
  _runtimeApi: target.ApplyDamage(new RpgDamageInfo(16, "Demo", player)); player.DamageApplied
    += (info, applied) => ...; attack.UsePrimaryAttack(); character.Restore().
  _sceneWorkflow: Select RpgCombatDemoController for the loop settings. MeleeNpc
    (RpgContactDamage) and RangedNpc (NpcRpgCombatBrain) events feed the log and
    the HUD; the player's OnDeath / OnRevived switch the status row.
  _verification: 'Turn Auto loop off and walk into MeleeNpc with WASD: every contact
    hit is logged with its source. Let the player die, then press Restore All.'
  _showRuntimeOverlay: 1
  _corner: 1
  _accentColor: {r: 0.96, g: 0.45, b: 0.38, a: 1}
  _backgroundColor: {r: 0.11764706, g: 0.11764706, b: 0.15686275, a: 0.8509804}
