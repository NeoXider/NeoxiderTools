MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2068247147}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2f9eb3d1945ff1640a88058f7d4f2b42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Neo.Rpg.Demo::Neo.Samples.ModuleDemoSceneInfo
  _moduleName: "Neo.GridSystem \xB7 TicTacToe"
  _purpose: "TicTacToeBoardService adds turns and n-in-a-row wins on top of any FieldGenerator
    field. Click a cell to place X; the bot answers as O. Switch to 5\xD75 with four
    in a row (WinLineLength) and block cells to change the rules."
  _runtimeApi: TicTacToeBoardService.TryMakeMove / ResetBoard / WinLineLength / WinningLine,
    FieldGenerator.SetWalkable / SetEnabled / GenerateField, OnCellStateChanged for
    views.
  _sceneWorkflow: 'Select GridSystem_TicTacToe: FieldGenerator (size, movement preset)
    and TicTacToeBoardService (Reset On Start, Win Line Length); its events are wired
    to GridSystemTicTacToeDemoUI in the Inspector.'
  _verification: 'Play: three in a row lights the winning line (WinningLine); a full
    board is a draw; a blocked center cannot be played.'
  _showRuntimeOverlay: 1
  _corner: 0
  _accentColor: {r: 0.25, g: 0.79, b: 0.94, a: 1}
  _backgroundColor: {r: 0.11764706, g: 0.11764706, b: 0.15686275, a: 0.8509804}
  _panelWidth: 420
  _startCollapsed: 0
  _hints:
  - 'Reset board -> TicTacToeBoardService.ResetBoard directly (no script): see the
    button''s OnClick.'
  - OnPlayerChanged / OnWinnerDetected / OnDrawDetected -> GridSystemTicTacToeDemoUI
    on 'GridSystemTicTacToeDemoUI'.
  - The view redraws single cells from FieldGenerator.OnCellStateChanged, raised
    by the service.
  _overlayRoot: {fileID: 1430303103}
  _titleLabel: {fileID: 1973966688}
  _descriptionLabel: {fileID: 188581277}
  _hintsLabel: {fileID: 1900973101}
  _collapseLabel: {fileID: 2132045684}
  _collapsibleParts:
  - {fileID: 2059307994}
  - {fileID: 31301466}
