  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#7D5CF0>\xBB</color>  <b>Runtime API:</b> AbilitySystem.Cast(CastRequest.AtUnit
    / NoTarget), GrantAbility, ApplyModifier; AbilitySystemBehaviour.Paused freezes
    cooldowns and DoTs on the level-up screen.\n<color=#7D5CF0>\xBB</color>  <b>Scene
    workflow:</b> Survivor Game holds the config; Ability System lists the library,
    the 'bolt' archetype and Spatial Cell Size 3 (grid queries for hundreds of units).\n<color=#7D5CF0>\xBB</color> 
    <b>Verification:</b> WASD to move, weapons fire by themselves, XP orbs level
    you up; Level up now opens the card picker at once.\n<color=#7D5CF0>\xBB</color> 
    [Demo] World/Player: AbilityUnitBehaviour + SurvivorPlayerController\n<color=#7D5CF0>\xBB</color> 
    [Demo] World/Templates: pooled enemies, XP orb, projectile\n<color=#7D5CF0>\xBB</color> 
    [Demo] HUD: SurvivorHudView; cards -> SurvivorGame.PickUpgrade(i)"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
