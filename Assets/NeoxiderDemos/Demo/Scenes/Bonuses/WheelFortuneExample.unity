  m_Script: {fileID: 11500000, guid: 2f9eb3d1945ff1640a88058f7d4f2b42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Neo.Rpg.Demo::Neo.Samples.ModuleDemoSceneInfo
  _moduleName: "Neo.Bonus \xB7 WheelFortune"
  _purpose: Wheel of fortune on uGUI. Spin() accelerates, Stop() slows it down and
    snaps to a sector, OnWinIdVariant(sector) reports the result. WheelMoneyWin turns
    the sector into coins.
  _runtimeApi: wheel.Spin() / Stop() / canUse / State / GetPrize(id) / OnWinIdVariant;
    WheelFortune.ResolveSectorIndex(...) without a scene; WheelMoneyWin.Win(id).
  _sceneWorkflow: 'Select Canvas/WheelFortune: OnWinIdVariant calls Wheel Money Win
    and Demo Controller. [Demo] Services holds Wallet (Money) and the prize table
    (wins).'
  _verification: 'Play: SPIN, then STOP. The sector under the arrow pays its prize;
    the single-use wheel locks until Re-arm wheel.'
  _showRuntimeOverlay: 1
  _corner: 0
  _accentColor: {r: 0.98, g: 0.45, b: 0.62, a: 1}
  _backgroundColor: {r: 0.11764706, g: 0.11764706, b: 0.15686275, a: 0.8509804}
  _panelWidth: 460
  _startCollapsed: 0
  _hints:
  - SPIN / STOP -> WheelFortune.Spin / Stop (prefab buttons)
  - 'Sector labels = WheelMoneyWin.wins: the number under the arrow is what you win'
  - Spin from code -> Spin(), then Stop() after 1.5 s
  _overlayRoot: {fileID: 623696426}
  _titleLabel: {fileID: 1089734436}
  _descriptionLabel: {fileID: 1274610770}
  _hintsLabel: {fileID: 488434333}
  _collapseLabel: {fileID: 70249680}
  _collapsibleParts:
  - {fileID: 2115869092}
  - {fileID: 1757798450}
