.el {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 16px;
}

.el__box {
    margin-bottom: 8px;
}

.el__b {
    min-width: 120px;
    height: 44px;
}

.el__f {
    height: 44px;
    margin-bottom: 4px;
}

.el__icon {
    width: 32px;
    height: 32px;
}

.el__scroll {
    height: 80px;
}

.el__t {
    color: #f2eada;
    font-size: 16px;
}

#el-icon {
    background-image: url("/input/images/icon.png");
    -unity-background-scale-mode: scale-to-fit;
}
