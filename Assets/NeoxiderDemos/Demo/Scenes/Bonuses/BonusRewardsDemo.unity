  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#FFA84C>\xBB</color>  <b>Runtime API:</b> collection.TryAddItem(i)
    / GetPrize() / ClearCollection() / Set; box.AddProgress() / TakePrize() / CheckProgress;
    gift.TakeReward() / CanTakeReward() / RemainingTime / SetRewardAvailableNow().\n<color=#FFA84C>\xBB</color> 
    <b>Scene workflow:</b> [Demo] Services: Pizza Collection (catalog in Data/Bonus/Pizzas),
    Gift (CooldownReward), Coins (TimeReward, legacy), Wallet (Money). The slot row
    holds the CollectionVisualManager, the chest row the Box, the details row the
    ItemCollectionInfo.\n<color=#FFA84C>\xBB</color>  <b>Verification:</b> Play:
    Claim gift, Gift now, Claim gift until the chest shows 300/300, then Open chest:
    a random pizza unlocks and can be selected. Reset demo progress locks every pizza,
    empties the chest, makes both timers ready and zeroes the wallet; every key it
    writes stays under NeoDemo.*.\n<color=#FFA84C>\xBB</color>  Claim gift \u203A
    CooldownReward.Take \u203A OnRewardClaimed \u203A Box.AddProgress\n<color=#FFA84C>\xBB</color> 
    Open chest \u203A Box.TakePrize \u203A Collection.GetPrize \u203A the slot unlocks\n<color=#FFA84C>\xBB</color> 
    Unlocked slot \u203A CollectionVisualManager.OnSetItem \u203A ItemCollectionInfo.SetItemId"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
