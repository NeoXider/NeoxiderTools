  m_Script: {fileID: 11500000, guid: 2f9eb3d1945ff1640a88058f7d4f2b42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Neo.Rpg.Demo::Neo.Samples.ModuleDemoSceneInfo
  _moduleName: "Neo.Tools.View \xB7 LightAnimator + MeshEmission"
  _purpose: Five point lights, one AnimationType each (labels in the scene). The
    spheres' MeshEmission follows its light, so the glow pulses with it.
  _runtimeApi: lightAnimator.Play / Pause / Resume / Stop / ResetToOriginal; AnimationSpeed,
    Min/MaxIntensity, AnimationType; ManualUpdate + Tick(dt); UseUnscaledTime; Intensity
    (reactive).
  _sceneWorkflow: Select a 'Light (n)' object to see its LightAnimator; its Sphere
    child carries MeshEmission. 'Light' wires Intensity.OnChanged to the card label
    in the Inspector.
  _verification: 'Enter Play Mode: lights flicker/pulse, Manual clock freezes them
    until Step, and with Unscaled time on they ignore Time.timeScale = 0.'
  _showRuntimeOverlay: 1
  _corner: 0
  _accentColor: {r: 1, g: 0.82, b: 0.36, a: 1}
  _backgroundColor: {r: 0.11764706, g: 0.11764706, b: 0.15686275, a: 0.8509804}
  _panelWidth: 460
  _startCollapsed: 0
  _hints:
  - Card -> LightDemoController -> the real LightAnimator API
  - 'Manual clock: ManualUpdate = true, then Tick(0.1) per Step'
  - 'Intensity.OnChanged -> label: a NoCode reactive binding'
  _overlayRoot: {fileID: 1693288729}
  _titleLabel: {fileID: 1726053562}
  _descriptionLabel: {fileID: 706419076}
  _hintsLabel: {fileID: 1965814464}
  _collapseLabel: {fileID: 1007135589}
  _collapsibleParts:
  - {fileID: 370345245}
  - {fileID: 1296872681}
