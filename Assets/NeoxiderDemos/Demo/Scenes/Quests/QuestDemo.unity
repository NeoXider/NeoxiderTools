  m_Script: {fileID: 11500000, guid: 2f9eb3d1945ff1640a88058f7d4f2b42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Neo.Rpg.Demo::Neo.Samples.ModuleDemoSceneInfo
  _moduleName: "Neo.Quest \xB7 QuestManager"
  _purpose: QuestConfig assets define objectives; QuestManager tracks quest state,
    credits progress by quest and index or by Target Id, saves through SaveProvider
    and raises events for UI and rewards.
  _runtimeApi: manager.TryAcceptQuest / AddObjectiveProgress / NotifyKill(id, n)
    / NotifyCollect / NotifyTalk / NotifyReachPoint / FailQuest / RestartQuest; C#
    events QuestAccepted, ObjectiveProgress, QuestCompleted.
  _sceneWorkflow: '[Demo] Services: Quest Manager (Known Quests = Data/Quest assets),
    Gold Wallet (Money), Quest NoCode Actions (one QuestNoCodeAction per world button).'
  _verification: 'Play: Wolf Hunt -> Accept -> Kill 3 wolves completes it and pays
    25 gold. States persist between sessions; Reset all replays.'
  _showRuntimeOverlay: 1
  _corner: 0
  _accentColor: {r: 1, g: 0.72, b: 0.25, a: 1}
  _backgroundColor: {r: 0.11764706, g: 0.11764706, b: 0.15686275, a: 0.8509804}
  _panelWidth: 460
  _startCollapsed: 0
  _hints:
  - Journal buttons -> QuestDemoController (C# API)
  - World buttons -> QuestNoCodeAction.Execute (NoCode, by Target Id)
  - "Quest Manager \u203A On Quest Completed -> Money.Add (reward without code)"
  _overlayRoot: {fileID: 1953286074}
  _titleLabel: {fileID: 1229967492}
  _descriptionLabel: {fileID: 1535776208}
  _hintsLabel: {fileID: 1980537748}
  _collapseLabel: {fileID: 2025908094}
  _collapsibleParts:
  - {fileID: 1778524581}
  - {fileID: 452201948}
