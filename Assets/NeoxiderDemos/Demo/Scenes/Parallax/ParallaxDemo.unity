  m_Script: {fileID: 11500000, guid: 2f9eb3d1945ff1640a88058f7d4f2b42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Neo.Rpg.Demo::Neo.Samples.ModuleDemoSceneInfo
  _moduleName: "Neo.Parallax \xB7 ParallaxLayer"
  _purpose: 'Seven ParallaxLayer bands tile and recycle around one camera. The multiplier
    is how much a band resists the camera: -1 follows it (sky), 0 stays in the world,
    positive values race past in front.'
  _runtimeApi: parallaxLayer.SetTargetCamera(camera); TargetCamera. Multiplier, scrollSpeed,
    tiling, spacing and sprite variants are Inspector settings.
  _sceneWorkflow: "Select a band under [Demo] World / Band \xB7 */Layer to see its
    ParallaxLayer (Target Camera, Parallax Multiplier, Scroll Speed). Edit-mode preview
    shows the tiles."
  _verification: 'Enter Play Mode: the camera pans, deeper bands move slower, clouds
    drift even with Auto pan off, and jumps of 25 units leave no gaps.'
  _showRuntimeOverlay: 1
  _corner: 0
  _accentColor: {r: 1, g: 0.6, b: 0.2, a: 1}
  _backgroundColor: {r: 0.11764706, g: 0.11764706, b: 0.15686275, a: 0.8509804}
  _panelWidth: 460
  _startCollapsed: 0
  _hints:
  - Pan speed / Auto pan / Reverse / Jump -> ParallaxDemoController moves the camera
  - Every band reads the camera delta in LateUpdate and recycles its tiles
  - 'Clouds: scrollSpeed adds motion of their own'
  _overlayRoot: {fileID: 584312241}
  _titleLabel: {fileID: 1615913337}
  _descriptionLabel: {fileID: 30273487}
  _hintsLabel: {fileID: 1747940369}
  _collapseLabel: {fileID: 365434709}
  _collapsibleParts:
  - {fileID: 106206362}
  - {fileID: 26429867}
