  m_Name: 
  m_EditorClassIdentifier: Neo.Rpg.Demo::Neo.Samples.ModuleDemoSceneInfo
  _moduleName: "Neo.Tools \xB7 CameraAspectRatioScaler"
  _purpose: 'One component on the camera keeps a design composition readable on every
    aspect ratio: Fit Width, Fit Height, Fit Both (bars) or Manual.'
  _runtimeApi: Mode, TargetResolution, ReferenceOrthographicSize / ReferenceFieldOfView,
    Refresh(), CaptureReferenceFromCamera().
  _sceneWorkflow: 'Select ''Main Camera'': Reference Size is stored on the scaler,
