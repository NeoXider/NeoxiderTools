  m_Script: {fileID: 11500000, guid: 2f9eb3d1945ff1640a88058f7d4f2b42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Neo.Rpg.Demo::Neo.Samples.ModuleDemoSceneInfo
  _moduleName: "Neo.Rpg \xB7 RpgCharacter"
  _purpose: One RpgCharacter holds resources (HP, Stamina, custom DarkMana), stats,
    level, upgrade points and the damage pipeline. Both characters are configured
    by RpgCharacterTemplate assets, not code.
  _runtimeApi: player.Damage / Heal / Spend("Stamina", 30) / Refill("DarkMana", 15)
    / AddLevel / UpgradeStat("Vitality"); enemy.ApplyDamage(new RpgDamageInfo(40,
    "Fire", player)); AddDamageModifier; DamageApplied event.
  _sceneWorkflow: Select Rpg Demo Player (Template field). Rows carry RpgResourceBinding
    / RpgStatBinding, NoCode buttons carry RpgNoCodeAction, the Low HP row carries
    a NeoCondition.
  _verification: 'Damage the player below 35% HP: the Low HP row turns red without
    code. Level Up grants a point; Upgrade Vitality adds +15 Max HP.'
  _showRuntimeOverlay: 1
  _corner: 1
  _accentColor: {r: 0.96, g: 0.45, b: 0.38, a: 1}
  _backgroundColor: {r: 0.11764706, g: 0.11764706, b: 0.15686275, a: 0.8509804}
  _panelWidth: 440
  _startCollapsed: 0
  _hints: []
