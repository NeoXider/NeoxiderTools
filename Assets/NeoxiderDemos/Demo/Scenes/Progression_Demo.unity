  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#42D9A3>\xBB</color>  <b>Runtime API:</b> levelComponent.AddXp(n);
    progression.TryUnlockNode / TryBuyPerk(id, out reason) / ActivatePremium() /
    ResetProgression(); C# events NodeUnlocked, PerkPurchased, PremiumActivated.\n<color=#42D9A3>\xBB</color> 
    <b>Scene workflow:</b> ProgressionDemoManager: LevelComponent + ProgressionManager
    with the Data/Progression assets. [Demo] Services/Progression NoCode Actions:
    one ProgressionNoCodeAction per button.\n<color=#42D9A3>\xBB</color>  <b>Verification:</b>
    Play: +500 XP levels up and pays perk points; unlock Forge at level 2, buy Swift
    Feet then Blade Master; Activate Premium pays premium entries of reached levels.\n<color=#42D9A3>\xBB</color> 
    XP buttons -> ProgressionDemoUI.AddXp -> LevelComponent.AddXp (C#)\n<color=#42D9A3>\xBB</color> 
    Right column -> ProgressionNoCodeAction.Execute (NoCode, no scripts)\n<color=#42D9A3>\xBB</color> 
    Perk points / Total XP labels: NoCodeBindText on reactive state\n<color=#42D9A3>\xBB</color> 
    LevelComponent.OnLevelUp and ProgressionManager events -> ProgressionDemoUI"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
