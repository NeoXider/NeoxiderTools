      m_Calls: []
  m_text: "<color=#59F2FF>\xBB</color>  <b>Runtime API:</b> UIMeshRigLayoutBuilder.Apply(rig,
    UIMeshRigLayoutPreset.Character); UIMeshRigPointMotion.ApplyPreset / Play; rig.SetSource(sprite,
    color).\n<color=#59F2FF>\xBB</color>  <b>Scene workflow:</b> Select 'Interactive
    Rig Graphic' or its 'Rig Point' child; the Scene overlay switches Setup / Pose,
    drag the point to bend the logo.\n<color=#59F2FF>\xBB</color>  <b>Verification:</b>
    Top row: static pose, procedural motion, Animator (moves in Play Mode only).
    Bottom row: uGUI, UI Toolkit, world mesh, SpriteRenderer.\n<color=#59F2FF>\xBB</color> 
    Click a top-row logo: Button.onClick -> UIMeshRigDemoClickPulse.Play\n<color=#59F2FF>\xBB</color> 
    [Demo] World/Sprite Renderer - Character: UIMeshRigSpriteRenderer deforms a runtime
    sprite clone\n<color=#59F2FF>\xBB</color>  Steady rigs rebuild into reused buffers:
    no GC allocations per frame"
  m_isRightToLeft: 0
