.ps {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.ps__b {
    min-width: 120px;
    height: 44px;
    background-color: #223344;
}

.ps__b:hover {
    background-color: #335566;
}

.ps__b:active {
    background-color: #112233;
}

.ps__b:focus {
    border-width: 2px;
    border-color: #8ff0d4;
}

.ps__b:disabled {
    opacity: 0.5;
}

.ps__t:checked {
    color: #8ff0d4;
}
