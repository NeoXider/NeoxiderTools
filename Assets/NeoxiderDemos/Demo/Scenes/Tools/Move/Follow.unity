  m_Script: {fileID: 11500000, guid: 2f9eb3d1945ff1640a88058f7d4f2b42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Neo.Rpg.Demo::Neo.Samples.ModuleDemoSceneInfo
  _moduleName: "Neo.Tools \xB7 Follow"
  _purpose: Five Follow components chase one Target. The three green capsules are
    the original scene; Rail Follower (position limits) and Turret (2D aim limit)
    live in [Demo] World.
  _runtimeApi: follow.SetTarget(t), SetPositionSpeed(v), SetPositionSmoothMode(Follow.SmoothMode.Lerp),
    SetDeadzoneEnabled(true), TeleportToTarget(); events onStartFollowing, onStopFollowing,
    onTargetLost.
  _sceneWorkflow: 'Select a follower: target, smoothing, deadzone, limits and events
    are Inspector fields. The speed slider, deadzone toggle and Teleport button call
    Follow directly through persistent UnityEvents.'
