  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2f9eb3d1945ff1640a88058f7d4f2b42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Neo.Rpg.Demo::Neo.Samples.ModuleDemoSceneInfo
  _moduleName: "Neo.Abilities \xB7 NoCode"
  _purpose: 'Data-driven abilities without code: two AbilityUnitBehaviour units built
    from UnitTemplate assets, a caster with Zap and HealPulse, and NoCode bridges
    on the buttons.'
  _runtimeApi: AbilityCasterBehaviour.TryCastAtUnit / Cast(CastRequest) -> CastResult,
    GetCooldownNormalized; AbilityUnitBehaviour.SetLevel / ApplyDamage / ApplyHeal.
  _sceneWorkflow: Buttons -> AbilityNoCodeAction.Execute; bars -> SetProgress on
    HealthNormalized and AbilityCooldownSource; Auto Zap toggle -> AbilityAutoCaster.enabled.
  _verification: Hit 20 then Heal (+15), a second Heal is rejected by the cooldown,
    Zap deals 12 / 20 / 30 at levels 1 / 2 / 3, Reset restores both units.
  _showRuntimeOverlay: 1
  _corner: 0
  _accentColor: {r: 0.49, g: 0.36, b: 0.94, a: 1}
  _backgroundColor: {r: 0.11764706, g: 0.11764706, b: 0.15686275, a: 0.8509804}
  _panelWidth: 460
  _startCollapsed: 0
  _hints:
  - 'Btn_Hit Player 20 / Btn_Cast Heal: Button + AbilityNoCodeAction'
  - 'Player: unit, caster, auto-caster, cooldown source; TrainingDummy: unit'
  - Player / TrainingDummy On Damaged -> AbilitiesDemoGuide (persistent)
  - 'Assets: Scenes/Abilities/Assets (DemoUnit, TrainingDummyUnit, Zap, HealPulse)'
  _overlayRoot: {fileID: 969302580}
  _titleLabel: {fileID: 279640387}
  _descriptionLabel: {fileID: 25666300}
  _hintsLabel: {fileID: 1407450599}
  _collapseLabel: {fileID: 1721974647}
  _collapsibleParts:
  - {fileID: 711189257}
  - {fileID: 688680038}
