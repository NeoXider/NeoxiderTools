MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1881743942}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2f9eb3d1945ff1640a88058f7d4f2b42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Neo.Rpg.Demo::Neo.Samples.ModuleDemoSceneInfo
  _moduleName: "Neo.UI \xB7 UI components"
  _purpose: Six small Neo.UI building blocks, each wired in the Inspector without
    code. Every column of the card shows one of them doing its job; the lines below
    say what each one is for.
  _runtimeApi: bar.Select / Next / Prev + SelectionChanged; view.SetCurrentState
    / NextState + StateChanged; pausePage.gameObject.SetActive(true / false); fakeLoad.Load
    / EndLoad; shake.Shake / StopShake; anchorMove.SetX / SetY / SetAnchor / Apply.
  _sceneWorkflow: 'Every control is a persistent UnityEvent: select a button, the
    CategoryBar row or the FakeLoad bar row to see its calls. The pause screen is
    the inactive ''[Demo] Frame/Pause Page'' object.'
  _verification: 'Play: tabs switch the page (Next skips Locked), the bar loads,
    Pause stops the scaled square while the unscaled one, the shakes and the loader
    keep running.'
  _showRuntimeOverlay: 1
  _corner: 0
  _accentColor: {r: 0.3, g: 0.85, b: 0.75, a: 1}
  _backgroundColor: {r: 0.11764706, g: 0.11764706, b: 0.15686275, a: 0.8509804}
  _panelWidth: 420
  _startCollapsed: 0
  _hints:
  - CategoryBar - tab strip that owns the selection, skips disabled tabs and reports
    index / id
  - VariantView - one state index switches colours, texts and objects (tab pages,
    a badge)
  - 'PausePage - pause screen: while active it holds Time.timeScale (and GM pause
    / cursor)'
  - 'FakeLoad - fake loading progress for splash screens: OnChange 0..1, OnFinisLoad'
  - ButtonShake - shakes a RectTransform on press or on Shake() (error feedback)
  - AnchorMove - snaps a RectTransform's anchors to one x / y point; the slider calls
    SetX
  _overlayRoot: {fileID: 1563488795}
  _titleLabel: {fileID: 708850767}
  _descriptionLabel: {fileID: 1356272312}
  _hintsLabel: {fileID: 1102031127}
  _collapseLabel: {fileID: 1206901124}
  _collapsibleParts:
  - {fileID: 2067017968}
  - {fileID: 851900637}
