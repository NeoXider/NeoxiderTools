  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#FFC245>\xBB</color>  <b>Runtime API:</b> ChanceManager.TryEvaluate
    / GetNormalizedWeight \xB7 ChanceSystemBehaviour.GenerateId \xB7 IntegerChanceTable.Roll
    / TryGetOdds / GetIndex(ticket).\n<color=#FFC245>\xBB</color>  <b>Scene workflow:</b>
    Select 'Chance': Events By Index[i] lights tile i and writes Last drop; OnIdGenerated
    clears the highlight, writes Index and calls ChanceDemoController.RecordRoll.\n<color=#FFC245>\xBB</color> 
    <b>Verification:</b> Play: Roll a few times, then Sample 1,000 - the bars settle
    on the white expected markers. Ten Draw 100,000 presses average one jackpot.\n<color=#FFC245>\xBB</color> 
    Btn_Roll -> ChanceSystemBehaviour.GenerateVoid + Counter.Add(1) (NoCode)\n<color=#FFC245>\xBB</color> 
    Events By Index -> tile Selected.SetActive + SetText.Set (NoCode)\n<color=#FFC245>\xBB</color> 
    Sample / Draw -> ChanceDemoController -> ChanceManager / IntegerChanceTable (C#)"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
