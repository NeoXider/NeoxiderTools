  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2f9eb3d1945ff1640a88058f7d4f2b42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Neo.Rpg.Demo::Neo.Samples.ModuleDemoSceneInfo
  _moduleName: "Example game \xB7 Survivor 2D"
  _purpose: 'A Vampire-Survivors-style game built only from library components and
    UnityEvents: abilities, spawner, follow, magnet, loot, level, chance draft, timer
    and scene flow.'
  _runtimeApi: Spawner (ring, weights, unlock, ramp, cap), MagneticField.OnObjectReached,
    LevelComponent.AddXp / OnLevelUp, ChanceSystemBehaviour.GenerateUnique / ConsumePick,
    AbilityNoCodeAction.Execute, AbilityUnitBehaviour.OnMoveSpeedChanged.
  _sceneWorkflow: Player = KeyboardMover + AbilityUnitBehaviour + AbilityAutoCaster
    + MagneticField; Enemy templates = AbilityUnitBehaviour + bite ability + Follow
    + Loot + Despawner; Services/Run holds XP Level, Kills, Survival Timer, Scene
    Flow and Upgrade Draft.
  _verification: WASD to move; weapons fire by themselves; XP orbs fly to you and
    level you up; pick a card; survive 3 minutes to win.
  _showRuntimeOverlay: 1
  _corner: 3
  _accentColor: {r: 0.49, g: 0.36, b: 0.94, a: 1}
  _backgroundColor: {r: 0.11764706, g: 0.11764706, b: 0.15686275, a: 0.8509804}
  _panelWidth: 420
  _startCollapsed: 1
  _hints:
  - '[Demo] World/Player: OnMoveSpeedChanged -> KeyboardMover.SetSpeed; magnet ->
    AddXp + DespawnOther'
  - '[Demo] World/Templates/Enemy_*: OnDied -> Loot.DropLoot, Kills.Add(1), Despawner.Despawn'
  - '[Demo] Services/Run: OnLevelUp -> cards on, Pause, Upgrade Draft.GenerateUniqueVoid'
  _overlayRoot: {fileID: 154675029}
  _titleLabel: {fileID: 853276057}
  _descriptionLabel: {fileID: 1009101914}
  _hintsLabel: {fileID: 773083096}
  _collapseLabel: {fileID: 226949413}
  _collapsibleParts:
  - {fileID: 967694410}
  - {fileID: 1176710413}
