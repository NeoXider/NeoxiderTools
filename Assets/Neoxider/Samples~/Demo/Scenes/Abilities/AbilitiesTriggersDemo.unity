  m_Script: {fileID: 11500000, guid: 2f9eb3d1945ff1640a88058f7d4f2b42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Neo.Rpg.Demo::Neo.Samples.ModuleDemoSceneInfo
  _moduleName: "Neo.Abilities \xB7 triggers and modifiers"
  _purpose: 'Six reactive mechanics built only from data: thorns (reflect), an attack
    enhancer, a mark for the next hits, a stacking poison, a formation zone and an
    auto-defense shield. The assets come from AbilityTemplates; the trace explains
    every reaction.'
  _runtimeApi: AbilityCasterBehaviour.TryCastAtUnit / TryCast / TryCastAtPoint; AbilitySystem.Trace
    (Explain); ModifierInstance.GetRemainingCharges / Stacks; AbilityTemplates.*.
  _sceneWorkflow: 'Hub: library, formation ring archetype, Trace Enabled. Units:
    UnitTemplate assets with abilities and innate modifiers (shield passive, thorns).
    Buttons -> AbilitiesTriggersDemoGuide (persistent).'
  _verification: 'Strike: golem -20, hero -6 (thorns). Empower: three hits of 30.
    Mark: three hits +15. Dart: venom stacks tick 4 per stack. Formation: ring, pulses,
    slow. Smash x3: the shield appears below 40% HP.'
  _showRuntimeOverlay: 1
  _corner: 0
  _accentColor: {r: 1, g: 0.55, b: 0.26, a: 1}
  _backgroundColor: {r: 0.11764706, g: 0.11764706, b: 0.15686275, a: 0.8509804}
  _panelWidth: 430
  _startCollapsed: 0
  _hints:
  - 'Assets: Scenes/Abilities/Assets/Triggers (abilities, modifiers, templates, library,
    ring prefab)'
  - 'Modifier reactions: Trigger, Max Triggers, Remove When Spent, Hits Only, Cooldown'
  - 'Why panel: AbilitySystem.Trace.Explain(latest reaction)'
  _overlayRoot: {fileID: 1215876427}
  _titleLabel: {fileID: 1877721493}
  _descriptionLabel: {fileID: 959591343}
  _hintsLabel: {fileID: 2053473089}
  _collapseLabel: {fileID: 883748749}
  _collapsibleParts:
