.vl-root.htu-media-base {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: #ffffff;
    color: #111114;
    font-size: 14px;
}

.vl-root .htu-media-base {
    flex-shrink: 0;
}

.vl-muted.htu-media-base {
    color: #73757e;
}

.vl-primary.htu-media-base {
    color: #2563eb;
}

.vl-small.htu-media-base {
    font-size: 12px;
    white-space: normal;
}

.vl-center.htu-media-base {
    -unity-text-align: middle-center;
}

.vl-hidden.htu-media-base,
.is-hidden.htu-media-base {
    display: none;
}

.vl-header.htu-media-base {
    height: 64px;
    border-bottom-width: 1px;
    border-bottom-color: #e8ebf2;
    background-color: rgba(255, 255, 255, 0.96);
}

.vl-header-inner.htu-media-base {
    flex-direction: row;
    align-items: center;
    align-self: center;
    width: 100%;
    max-width: 1152px;
    height: 64px;
    padding-right: 24px;
    padding-left: 24px;
}

.vl-brand-button.htu-media-base {
    width: 140px;
    height: 40px;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: #111114;
    -unity-font-style: bold;
    font-size: 17px;
    -unity-text-align: middle-left;
}

.vl-brand.htu-media-base {
    -unity-font-style: bold;
    font-size: 17px;
}

.vl-desktop-nav.htu-media-base {
    flex-direction: row;
    flex-grow: 1;
    align-items: center;
}

.vl-nav-link.htu-media-base {
    height: 38px;
    margin: 0;
    padding-right: 11px;
    padding-left: 11px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: #73757e;
    font-size: 14px;
}

.vl-nav-link.htu-media-base:hover,
.vl-link.htu-media-base:hover {
    color: #2563eb;
}

.vl-nav-active.htu-media-base {
    color: #2563eb;
}

.vl-header-actions.htu-media-base {
    flex-direction: row;
    align-items: center;
}

.vl-search.htu-media-base {
    width: 190px;
    height: 32px;
    margin-right: 8px;
    padding-left: 12px;
    border-width: 1px;
    border-color: #e2e5eb;
    border-radius: 8px;
    background-color: #fbfcff;
    color: #73757e;
    font-size: 12px;
    -unity-text-align: middle-left;
}

.vl-icon-button.htu-media-base {
    width: 36px;
    height: 36px;
    margin: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: #111114;
    font-size: 20px;
}

.vl-motion-button.htu-media-base {
    width: 74px;
    height: 32px;
    margin-top: 0;
    margin-right: 6px;
    margin-bottom: 0;
    margin-left: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: #73757e;
    font-size: 11px;
}

.vl-source-button.htu-media-base {
