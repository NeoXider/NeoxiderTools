  m_Script: {fileID: 11500000, guid: 2f9eb3d1945ff1640a88058f7d4f2b42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Neo.Rpg.Demo::Neo.Samples.ModuleDemoSceneInfo
  _moduleName: "Neo.UI \xB7 UI Mesh Rig"
  _purpose: 'Bends a sprite through a grid mesh driven by Rig Points. One geometry
    core, four outputs: uGUI, UI Toolkit, world MeshRenderer and SpriteRenderer.'
  _runtimeApi: UIMeshRigLayoutBuilder.Apply(rig, UIMeshRigLayoutPreset.Character);
    UIMeshRigPointMotion.ApplyPreset / Play; rig.SetSource(sprite, color).
  _sceneWorkflow: Select 'Interactive Rig Graphic' or its 'Rig Point' child; the
    Scene overlay switches Setup / Pose, drag the point to bend the logo.
  _verification: 'Top row: static pose, procedural motion, Animator (moves in Play
    Mode only). Bottom row: uGUI, UI Toolkit, world mesh, SpriteRenderer.'
  _showRuntimeOverlay: 1
  _corner: 0
  _accentColor: {r: 0.35, g: 0.95, b: 1, a: 1}
  _backgroundColor: {r: 0.11764706, g: 0.11764706, b: 0.15686275, a: 0.8509804}
  _panelWidth: 460
  _startCollapsed: 1
  _hints:
  - 'Click a top-row logo: Button.onClick -> UIMeshRigDemoClickPulse.Play'
  - '[Demo] World/Sprite Renderer - Character: UIMeshRigSpriteRenderer deforms a
    runtime sprite clone'
  - 'Steady rigs rebuild into reused buffers: no GC allocations per frame'
  _overlayRoot: {fileID: 541834019}
  _titleLabel: {fileID: 2033244579}
  _descriptionLabel: {fileID: 2071344706}
  _hintsLabel: {fileID: 684164230}
  _collapseLabel: {fileID: 1343635439}
  _collapsibleParts:
  - {fileID: 1147236417}
  - {fileID: 914007614}
