}

.vl-shimmer-wrap.htu-media-base {
    position: relative;
    overflow: hidden;
    width: 252px;
    height: 52px;
    margin-right: 16px;
    border-radius: 28px;
    background-color: #1d4ed8;
}

.vl-root .vl-primary-button.htu-media-base {
    opacity: 1;
    min-width: 180px;
    height: 50px;
    margin: 0;
    padding-right: 24px;
    padding-left: 24px;
    border-width: 0;
    border-radius: 28px;
    background-color: #1d4ed8;
    background-image: none;
    -unity-background-image-tint-color: #1d4ed8;
    color: #ffffff;
    -unity-font-style: bold;
    font-size: 14px;
}

.vl-root .vl-primary-button.htu-media-base:hover,
.vl-root .vl-primary-button.htu-media-base:focus {
    background-color: #1e40af;
    background-image: none;
    -unity-background-image-tint-color: #1e40af;
