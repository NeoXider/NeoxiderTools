  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2f9eb3d1945ff1640a88058f7d4f2b42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Neo.Rpg.Demo::Neo.Samples.ModuleDemoSceneInfo
  _moduleName: "Neo.GridSystem \xB7 Match3"
  _purpose: "A Match3 game assembled from GridSystem blocks: FieldGenerator owns
    the 8\xD78 field and its cell states, Match3BoardService adds swap, match and
    cascade rules, and a replaceable view draws it. Click a tile, then a neighbour
    to swap."
  _runtimeApi: FieldGenerator.GenerateField / SetWalkable / SetEnabled / SetOccupied,
    GridShapeMask.Create, GridPathfinder.TryFindPath / CollectReachableCells, Match3BoardService.TrySwapAndResolve
    / TryFindValidSwap / InitializeBoard.
  _sceneWorkflow: 'Select GridSystem_Match3: FieldGenerator (size, shape mask, movement
    preset), Match3BoardService (min match, tiles, delay) and GridSystemMatch3BoardView.
    Their events are wired in the Inspector.'
  _verification: 'Play: swap to clear lines; Cut corners / Diamond regenerate the
    field and the view follows; Block / Disable / Occupy change single cells; the
    path avoids them.'
  _showRuntimeOverlay: 1
  _corner: 0
  _accentColor: {r: 1, g: 0.45, b: 0.62, a: 1}
  _backgroundColor: {r: 0.11764706, g: 0.11764706, b: 0.15686275, a: 0.8509804}
  _panelWidth: 420
  _startCollapsed: 0
  _hints:
  - Buttons -> GridSystemMatch3DemoUI on 'GridSystemMatch3DemoUI'; each calls one
    GridSystem API.
  - Match3BoardService.OnMatchesResolved -> GridSystemMatch3DemoUI.HandleMatchesResolved
    (Inspector).
  - Cyan outline = cells from GridPathfinder; [Demo] Board Preview shows the layout
    in Edit Mode only.
  _overlayRoot: {fileID: 617851661}
  _titleLabel: {fileID: 485270719}
  _descriptionLabel: {fileID: 478440894}
  _hintsLabel: {fileID: 1440155291}
  _collapseLabel: {fileID: 103574933}
  _collapsibleParts:
  - {fileID: 1805802928}
  - {fileID: 1119674879}
