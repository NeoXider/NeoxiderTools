  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#7D5CF0>\xBB</color>  <b>Runtime API:</b> LevelComponent.AddXp
    / SetLevel / ResetProgress, LevelState / XpState / XpToNextLevelState, OnLevelUp;
    LevelManager.SaveLevel / NextLevel / SetMapId, Map.IsComplete.\n<color=#7D5CF0>\xBB</color> 
    <b>Scene workflow:</b> [Demo] Services/Player Level holds the LevelComponent
    and the two LevelNoCodeActions; 'Level Demo' holds LevelManager (World 1: 5 levels,
    Endless: infinite). Labels, grid and buttons are wired with persistent UnityEvents.\n<color=#7D5CF0>\xBB</color> 
    <b>Verification:</b> +XP fills the bar and levels up; Complete level unlocks
    the next grid cell; after 5 clears Map.IsComplete is YES. Stop and re-enter Play
    Mode: XP and progress return.\n<color=#7D5CF0>\xBB</color>  Player Level -> LevelState.OnChanged
    -> DemoValueReadout (NoCode label)\n<color=#7D5CF0>\xBB</color>  Level 1..5 cells:
    LevelButton events toggle Lock / Next / Done\n<color=#7D5CF0>\xBB</color>  Complete
    level -> LevelManager.SaveLevel; Endless map has no grid"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
