  m_Script: {fileID: 11500000, guid: 2f9eb3d1945ff1640a88058f7d4f2b42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Neo.Rpg.Demo::Neo.Samples.ModuleDemoSceneInfo
  _moduleName: "Neo.NoCode \xB7 Bindings"
  _purpose: 'Show any numeric value without code: each binding reads ''Counter''
    / Counter.Value and pushes it to text, a formatted string, an image fill or a
    slider.'
  _runtimeApi: binding.Binding.SourceRoot / MemberName, RefreshBinding(), UpdateMode;
    NoCodeFormattedText.SetValues(sources, format); SetProgress.SetRange(min, max).
  _sceneWorkflow: 'Select any label or bar on the right: its NoCode component names
    the source object, component and member. Buttons call Counter.Add / Set through
    persistent UnityEvents.'
  _verification: 'Play: +10 / -10 or drag the slider - the Reactive bindings follow
    at once, Poll catches up within 0.5 s, Once changes only on RefreshBinding().'
  _showRuntimeOverlay: 1
  _corner: 0
  _accentColor: {r: 0.49, g: 0.36, b: 1, a: 1}
  _backgroundColor: {r: 0.11764706, g: 0.11764706, b: 0.15686275, a: 0.8509804}
  _panelWidth: 440
  _startCollapsed: 0
  _hints:
  - Buttons / slider -> Counter.Add / Counter.Set (NoCode)
  - Counter.Value -> NoCodeBindText, NoCodeFormattedText, SetProgress
  - Poll binding -> OnTextChanged -> log
  _overlayRoot: {fileID: 1911650492}
  _titleLabel: {fileID: 891276908}
  _descriptionLabel: {fileID: 1464917768}
  _hintsLabel: {fileID: 447280050}
  _collapseLabel: {fileID: 1032241329}
  _collapsibleParts:
  - {fileID: 1626249841}
  - {fileID: 753838824}
